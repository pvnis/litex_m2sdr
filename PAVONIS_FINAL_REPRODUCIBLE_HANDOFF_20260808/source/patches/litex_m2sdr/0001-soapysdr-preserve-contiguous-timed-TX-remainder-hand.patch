+static bool m2sdr_tx_worker_trace_armed()
+{
+    const char *arm_file = m2sdr_env_tx_worker_trace_arm_file();
+    if (!arm_file)
+        return true;
+
+    static std::atomic<bool> armed{false};
+    if (armed.load(std::memory_order_relaxed))
+        return true;
+
+    if (::access(arm_file, F_OK) != 0)
+        return false;
+
+    bool expected = false;
+    if (armed.compare_exchange_strong(expected, true, std::memory_order_relaxed)) {
+        SoapySDR_logf(SOAPY_SDR_INFO,
+            "M2SDR TX worker trace armed by file: %s", arm_file);
+    }
+    return true;
+}
