+    rc = ad9361_get_rx_lo_freq(ad9361_phy, &rx_lo);
+    std::fprintf(f, "ad9361_get_rx_lo_freq_rc=%d value=%llu\n",
+                 rc, static_cast<unsigned long long>(rx_lo));
+    rc = ad9361_get_tx_rf_bandwidth(ad9361_phy, &tx_bw);
+    std::fprintf(f, "ad9361_get_tx_rf_bandwidth_rc=%d value=%u\n",
