+static bool m2sdr_env_tx_zero_after_arm_enabled()
+{
+    const char *v = std::getenv("M2SDR_SOAPY_TX_ZERO_AFTER_ARM");
+    return v && *v && std::strcmp(v, "0") != 0 &&
+           std::strcmp(v, "false") != 0 &&
+           std::strcmp(v, "FALSE") != 0 &&
+           std::strcmp(v, "off") != 0 &&
+           std::strcmp(v, "OFF") != 0 &&
+           std::strcmp(v, "no") != 0 &&
+           std::strcmp(v, "NO") != 0;
+}
+
+static std::atomic<uint64_t> g_tx_zero_after_arm_checks{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_enabled_checks{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_active_checks{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_probe_checks{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_probe_polls{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_probe_armed_polls{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_probe_armed_returns{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_zeroed_calls{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_zeroed_elems{0};
+static std::atomic<uint64_t> g_tx_zero_after_arm_zero_src_null{0};
+static std::atomic<int> g_tx_zero_after_arm_last_access_rc{-1};
+static std::atomic<int> g_tx_zero_after_arm_last_errno{0};
+
+static uint64_t m2sdr_env_tx_zero_after_arm_summary_period()
+{
+    const char *v = std::getenv("M2SDR_SOAPY_TX_ZERO_AFTER_ARM_SUMMARY_PERIOD");
+    if (!v || !*v)
+        return 1024;
+    const long n = std::strtol(v, nullptr, 10);
+    return n > 0 ? static_cast<uint64_t>(n) : 1;
+}
+
+static const char *m2sdr_getenv_or_empty(const char *name)
+{
+    const char *v = std::getenv(name);
+    return v ? v : "";
+}
+
+static void m2sdr_tx_zero_after_arm_write_summary(const char *reason, bool force = false)
+{
+    const char *path = std::getenv("M2SDR_SOAPY_TX_ZERO_AFTER_ARM_SUMMARY_PATH");
+    if (!path || !*path)
+        return;
 
+    static std::atomic<uint64_t> seq{0};
+    const uint64_t row = seq.fetch_add(1, std::memory_order_relaxed);
+    const uint64_t period = m2sdr_env_tx_zero_after_arm_summary_period();
+    if (!force && period > 1 && (row % period) != 0)
+        return;
+
+    FILE *f = std::fopen(path, "w");
+    if (!f) {
+        static std::atomic<bool> announced{false};
+        bool expected = false;
+        if (announced.compare_exchange_strong(expected, true, std::memory_order_relaxed)) {
+            SoapySDR_logf(SOAPY_SDR_ERROR,
+                "Unable to open M2SDR TX zero-after-arm summary path: %s", path);
+        }
+        return;
+    }
+
+    std::fprintf(f, "PAVONIS_M2SDR_TX_ZERO_AFTER_ARM_SUMMARY=1\n");
+    std::fprintf(f, "reason=%s\n", reason ? reason : "unknown");
+    std::fprintf(f, "summary_seq=%llu\n", static_cast<unsigned long long>(row));
+    std::fprintf(f, "env_M2SDR_SOAPY_TX_ZERO_AFTER_ARM=%s\n",
+                 m2sdr_getenv_or_empty("M2SDR_SOAPY_TX_ZERO_AFTER_ARM"));
+    std::fprintf(f, "env_M2SDR_SOAPY_TX_PROBE_ARM_FILE=%s\n",
+                 m2sdr_getenv_or_empty("M2SDR_SOAPY_TX_PROBE_ARM_FILE"));
+    std::fprintf(f, "env_M2SDR_SOAPY_TX_PROBE_ARM_POLL_PERIOD=%s\n",
+                 m2sdr_getenv_or_empty("M2SDR_SOAPY_TX_PROBE_ARM_POLL_PERIOD"));
+    std::fprintf(f, "env_M2SDR_SOAPY_TX_ZERO_AFTER_ARM_SUMMARY_PERIOD=%s\n",
+                 m2sdr_getenv_or_empty("M2SDR_SOAPY_TX_ZERO_AFTER_ARM_SUMMARY_PERIOD"));
+    std::fprintf(f, "checks=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_checks.load(std::memory_order_relaxed)));
+    std::fprintf(f, "enabled_checks=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_enabled_checks.load(std::memory_order_relaxed)));
+    std::fprintf(f, "active_checks=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_active_checks.load(std::memory_order_relaxed)));
+    std::fprintf(f, "probe_checks=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_probe_checks.load(std::memory_order_relaxed)));
+    std::fprintf(f, "probe_polls=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_probe_polls.load(std::memory_order_relaxed)));
+    std::fprintf(f, "probe_armed_polls=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_probe_armed_polls.load(std::memory_order_relaxed)));
+    std::fprintf(f, "probe_armed_returns=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_probe_armed_returns.load(std::memory_order_relaxed)));
+    std::fprintf(f, "zeroed_interleave_calls=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_zeroed_calls.load(std::memory_order_relaxed)));
+    std::fprintf(f, "zeroed_interleave_elems=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_zeroed_elems.load(std::memory_order_relaxed)));
+    std::fprintf(f, "zero_src_null_count=%llu\n",
+                 static_cast<unsigned long long>(g_tx_zero_after_arm_zero_src_null.load(std::memory_order_relaxed)));
+    std::fprintf(f, "last_probe_access_rc=%d\n",
+                 g_tx_zero_after_arm_last_access_rc.load(std::memory_order_relaxed));
+    std::fprintf(f, "last_probe_errno=%d\n",
+                 g_tx_zero_after_arm_last_errno.load(std::memory_order_relaxed));
+    std::fclose(f);
+}
+
+static void m2sdr_tx_zero_after_arm_record_zeroed(size_t elems)
+{
+    g_tx_zero_after_arm_zeroed_calls.fetch_add(1, std::memory_order_relaxed);
+    g_tx_zero_after_arm_zeroed_elems.fetch_add(elems, std::memory_order_relaxed);
+    m2sdr_tx_zero_after_arm_write_summary("zeroed_interleave");
+}
+
+static bool m2sdr_env_rx_ignore_timed_activation_enabled()
+{
+    const char *v = std::getenv("M2SDR_SOAPY_RX_IGNORE_TIMED_ACTIVATION");
+    return v && *v && std::strcmp(v, "0") != 0 &&
+           std::strcmp(v, "false") != 0 &&
+           std::strcmp(v, "FALSE") != 0 &&
+           std::strcmp(v, "off") != 0 &&
+           std::strcmp(v, "OFF") != 0 &&
+           std::strcmp(v, "no") != 0 &&
+           std::strcmp(v, "NO") != 0;
+}
+
+static bool m2sdr_rx_ignore_timed_activation_active(const long long timeNs)
+{
+    if (!m2sdr_env_rx_ignore_timed_activation_enabled())
+        return false;
+
+    static std::atomic<bool> announced{false};
+    bool expected = false;
+    if (announced.compare_exchange_strong(expected, true, std::memory_order_relaxed)) {
+        SoapySDR_logf(SOAPY_SDR_INFO,
+            "RX_IGNORE_TIMED_ACTIVATION active: ignoring requested RX timed activation for %lld ns",
+            (long long)timeNs);
+    }
+    return true;
+}
+
+static bool m2sdr_tx_probe_armed()
+{
+    const char *path = std::getenv("M2SDR_SOAPY_TX_PROBE_ARM_FILE");
+    if (!path || !*path)
+        return true;
+    g_tx_zero_after_arm_probe_checks.fetch_add(1, std::memory_order_relaxed);
+
+    static const unsigned poll_period = []() {
+        const char *v = std::getenv("M2SDR_SOAPY_TX_PROBE_ARM_POLL_PERIOD");
+        const long n = v && *v ? std::strtol(v, nullptr, 10) : 1024;
+        return n > 0 ? static_cast<unsigned>(n) : 1024U;
+    }();
+    static std::atomic<unsigned> poll_seen{0};
+    static std::atomic<bool> armed_cached{false};
+
+    const unsigned idx = poll_seen.fetch_add(1, std::memory_order_relaxed);
+    if ((idx % poll_period) == 0) {
+        const int rc = ::access(path, F_OK);
+        const int saved_errno = rc == 0 ? 0 : errno;
+        g_tx_zero_after_arm_probe_polls.fetch_add(1, std::memory_order_relaxed);
+        g_tx_zero_after_arm_last_access_rc.store(rc, std::memory_order_relaxed);
+        g_tx_zero_after_arm_last_errno.store(saved_errno, std::memory_order_relaxed);
+        if (rc == 0)
+            g_tx_zero_after_arm_probe_armed_polls.fetch_add(1, std::memory_order_relaxed);
+        armed_cached.store(rc == 0, std::memory_order_relaxed);
+    }
+
+    const bool armed = armed_cached.load(std::memory_order_relaxed);
+    if (armed)
+        g_tx_zero_after_arm_probe_armed_returns.fetch_add(1, std::memory_order_relaxed);
+    return armed;
+}
+
+static bool m2sdr_tx_zero_after_arm_active()
+{
+    g_tx_zero_after_arm_checks.fetch_add(1, std::memory_order_relaxed);
+    if (!m2sdr_env_tx_zero_after_arm_enabled()) {
+        m2sdr_tx_zero_after_arm_write_summary("disabled");
+        return false;
+    }
+    g_tx_zero_after_arm_enabled_checks.fetch_add(1, std::memory_order_relaxed);
+    if (!m2sdr_tx_probe_armed()) {
+        m2sdr_tx_zero_after_arm_write_summary("waiting_for_arm");
+        return false;
+    }
+    g_tx_zero_after_arm_active_checks.fetch_add(1, std::memory_order_relaxed);
+
+    static std::atomic<bool> announced{false};
+    bool expected = false;
+    if (announced.compare_exchange_strong(expected, true, std::memory_order_relaxed)) {
+        SoapySDR::log(SOAPY_SDR_INFO, "TX_ZERO_AFTER_ARM active: replacing TX writeStream payloads with zeros");
+        m2sdr_tx_zero_after_arm_write_summary("active_first", true);
+    }
+    m2sdr_tx_zero_after_arm_write_summary("active");
+    return true;
+}
+
+static const void *m2sdr_zero_tx_input_buffer(const std::string &format, const size_t elems)
+{
+    if (format == SOAPY_SDR_CF32) {
+        thread_local std::vector<float> zeros;
+        if (zeros.size() < elems * 2)
+            zeros.resize(elems * 2, 0.0f);
+        return zeros.data();
+    }
+    if (format == SOAPY_SDR_CS16) {
+        thread_local std::vector<int16_t> zeros;
+        if (zeros.size() < elems * 2)
+            zeros.resize(elems * 2, 0);
+        return zeros.data();
+    }
+    if (format == SOAPY_SDR_CS8) {
+        thread_local std::vector<int8_t> zeros;
+        if (zeros.size() < elems * 2)
+            zeros.resize(elems * 2, 0);
+        return zeros.data();
+    }
+    return nullptr;
+}
+
+static const void *m2sdr_advance_tx_input_buffer(
+    const void *buf,
+    const std::string &format,
+    const size_t elems)
+{
+    if (format == SOAPY_SDR_CF32)
+        return static_cast<const float *>(buf) + elems * 2;
+    if (format == SOAPY_SDR_CS16)
+        return static_cast<const int16_t *>(buf) + elems * 2;
+    if (format == SOAPY_SDR_CS8)
+        return static_cast<const int8_t *>(buf) + elems * 2;
+    return buf;
+}
 
