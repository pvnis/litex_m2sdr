+static FILE *m2sdr_tx_worker_trace_file()
+{
+    static bool opened = false;
+    static FILE *f = nullptr;
+    if (opened)
+        return f;
+    opened = true;
+
+    const char *path = m2sdr_env_tx_worker_trace_path();
+    if (!path)
+        return nullptr;
+
+    f = std::fopen(path, "a");
+    if (!f) {
+        SoapySDR_logf(SOAPY_SDR_ERROR,
+            "Unable to open M2SDR TX worker trace path: %s", path);
+        return nullptr;
+    }
+
+    std::fprintf(f, "# PAVONIS_M2SDR_TX_WORKER_TRACE v1\n");
+    std::fprintf(f,
+        "# wall_ns\tseq\tstage\thandle\tring_slot\tnum_elems\tmtu_elems\t"
+        "flags_pre\tflags_post\thas_time_pre\thas_time_post\teob_post\t"
+        "dedup_suppressed\tsource_time_ns\trelease_time_ns\thw_now_ns\t"
+        "slip_ns\tlate\treader_before\treader_after\tuser_before\t"
+        "user_after\thw_before\thw_after\tsw_before\tsw_after\t"
+        "cleared_before\tcleared_after\tzero_copy\tsamplerate\n");
+    std::fflush(f);
+    return f;
+}
+
+static void m2sdr_tx_worker_trace_emit(
+    const char *stage,
+    size_t handle,
+    size_t ringSlot,
+    size_t numElems,
+    size_t mtuElems,
+    int flagsPre,
+    int flagsPost,
+    bool dedupSuppressed,
+    long long sourceTimeNs,
+    long long releaseTimeNs,
+    bool timingValid,
+    long long hwNowNs,
+    long long slipNs,
+    bool late,
+    bool readerBefore,
+    bool readerAfter,
+    int64_t userBefore,
+    int64_t userAfter,
+    int64_t hwBefore,
+    int64_t hwAfter,
+    int64_t swBefore,
+    int64_t swAfter,
+    int64_t clearedBefore,
+    int64_t clearedAfter,
+    bool zeroCopy,
+    double samplerate)
+{
+    if (!m2sdr_env_tx_worker_trace_enabled())
+        return;
+    if (!m2sdr_tx_worker_trace_armed())
+        return;
+
+    static std::atomic<uint64_t> seq{0};
+    const uint64_t row = seq.fetch_add(1, std::memory_order_relaxed);
+    if (row >= m2sdr_env_tx_worker_trace_limit())
+        return;
+
+    FILE *f = m2sdr_tx_worker_trace_file();
+    if (!f)
+        return;
+
+    const bool has_time_pre = (flagsPre & SOAPY_SDR_HAS_TIME) != 0;
+    const bool has_time_post = (flagsPost & SOAPY_SDR_HAS_TIME) != 0;
+    const bool eob_post = (flagsPost & SOAPY_SDR_END_BURST) != 0;
+    std::fprintf(f,
+        "%lld\t%llu\t%s\t%zu\t%zu\t%zu\t%zu\t0x%x\t0x%x\t%d\t%d\t%d\t"
+        "%d\t%lld\t%lld\t%lld\t%lld\t%d\t%d\t%d\t%lld\t%lld\t%lld\t"
+        "%lld\t%lld\t%lld\t%lld\t%lld\t%d\t%.17g\n",
+        static_cast<long long>(m2sdr_wall_time_ns()),
+        static_cast<unsigned long long>(row),
+        stage ? stage : "unknown",
+        handle,
+        ringSlot,
+        numElems,
+        mtuElems,
+        flagsPre,
+        flagsPost,
+        has_time_pre ? 1 : 0,
+        has_time_post ? 1 : 0,
+        eob_post ? 1 : 0,
+        dedupSuppressed ? 1 : 0,
+        static_cast<long long>(sourceTimeNs),
+        static_cast<long long>(releaseTimeNs),
+        timingValid ? static_cast<long long>(hwNowNs) : 0LL,
+        timingValid ? static_cast<long long>(slipNs) : 0LL,
+        late ? 1 : 0,
+        readerBefore ? 1 : 0,
+        readerAfter ? 1 : 0,
+        static_cast<long long>(userBefore),
+        static_cast<long long>(userAfter),
+        static_cast<long long>(hwBefore),
+        static_cast<long long>(hwAfter),
+        static_cast<long long>(swBefore),
+        static_cast<long long>(swAfter),
+        static_cast<long long>(clearedBefore),
+        static_cast<long long>(clearedAfter),
+        zeroCopy ? 1 : 0,
+        samplerate);
+
+    const uint64_t flush_period = m2sdr_env_tx_worker_trace_flush_period();
+    if (flush_period == 1 || (flush_period > 1 && ((row + 1) % flush_period) == 0))
+        std::fflush(f);
+}
