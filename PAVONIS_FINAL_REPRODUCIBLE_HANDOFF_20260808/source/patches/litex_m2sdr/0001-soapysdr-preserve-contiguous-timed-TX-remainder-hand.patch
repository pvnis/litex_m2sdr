+        rc = ad9361_get_rx_rf_gain(ad9361_phy, ch, &rx_gain);
+        std::fprintf(f, "ad9361_get_rx_rf_gain_ch%u_rc=%d value_db=%d\n",
+                     ch,
+                     rc,
+                     rx_gain);
+        rc = ad9361_get_rx_gain_control_mode(ad9361_phy, ch, &rx_gain_mode);
