+static int16_t cf32_to_ci16_component(float value)
+{
+  if (!std::isfinite(value)) {
+    return 0;
+  }
+  const float scaled = value * static_cast<float>(std::numeric_limits<int16_t>::max());
+  const float clipped =
+      std::max(static_cast<float>(std::numeric_limits<int16_t>::min()),
+               std::min(static_cast<float>(std::numeric_limits<int16_t>::max()), scaled));
+  return static_cast<int16_t>(std::lround(static_cast<double>(clipped)));
+}
