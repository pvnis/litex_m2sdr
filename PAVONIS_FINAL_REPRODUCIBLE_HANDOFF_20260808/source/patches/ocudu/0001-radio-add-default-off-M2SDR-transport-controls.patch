+double parse_optional_bandwidth_env(const char* name)
+{
+  const char* value = std::getenv(name);
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return 0.0;
+  }
+
+  char*  end = nullptr;
+  double bandwidth_Hz = std::strtod(value, &end);
+  if ((end == value) || !std::isfinite(bandwidth_Hz) || (bandwidth_Hz <= 0.0)) {
+    return 0.0;
+  }
+  return bandwidth_Hz;
+}
+
+bool env_enabled(const char* name)
+{
+  const char* value = std::getenv(name);
+  return (value != nullptr) && (value[0] != '\0') && (std::string_view(value) != "0");
+}
+
+bool parse_physical_channel_offset(unsigned& offset)
+{
+  offset = 0;
+  const char* value = std::getenv("PAVONIS_SOAPY_PHYSICAL_CHANNEL_OFFSET");
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return true;
+  }
+
+  errno     = 0;
+  char* end = nullptr;
+  long  parsed = std::strtol(value, &end, 10);
+  if ((errno != 0) || (end == value) || (*end != '\0') || (parsed < 0) || (parsed > 1)) {
+    return false;
+  }
+  offset = static_cast<unsigned>(parsed);
+  return true;
+}
+
+double get_requested_bandwidth_hz(int direction)
+{
+  const double common = parse_optional_bandwidth_env("OCUDU_SOAPY_RF_BW_HZ");
+  const double specific =
+      parse_optional_bandwidth_env(direction == SOAPY_SDR_TX ? "OCUDU_SOAPY_TX_BW_HZ" : "OCUDU_SOAPY_RX_BW_HZ");
+  return (specific > 0.0) ? specific : common;
+}
+
+double parse_optional_frequency_env(const char* name)
+{
+  const char* value = std::getenv(name);
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return 0.0;
+  }
+
+  char*  end = nullptr;
+  double frequency_Hz = std::strtod(value, &end);
+  if ((end == value) || !std::isfinite(frequency_Hz) || (frequency_Hz <= 0.0)) {
+    return 0.0;
+  }
+  return frequency_Hz;
+}
+
+double parse_optional_gain_env(const char* name)
+{
+  const char* value = std::getenv(name);
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return std::numeric_limits<double>::quiet_NaN();
+  }
+
+  char*  end = nullptr;
+  double gain_dB = std::strtod(value, &end);
+  if ((end == value) || !std::isfinite(gain_dB) || (gain_dB < 0.0)) {
+    return std::numeric_limits<double>::quiet_NaN();
+  }
+  return gain_dB;
+}
+
+void log_soapy_channel_readback(radio_soapy_device& device, int direction, unsigned channel, bool direct_proof)
+{
+  ocudulog::basic_logger& logger = ocudulog::fetch_basic_logger("RF");
+
+  double rate_Hz      = -1.0;
+  double freq_Hz      = -1.0;
+  double gain_dB      = -1.0;
+  double bandwidth_Hz = -1.0;
+  bool   gain_mode_auto = false;
+
+  const bool rate_ok      = device.get_sample_rate(direction, channel, rate_Hz);
+  const bool freq_ok      = device.get_frequency(direction, channel, freq_Hz);
+  const bool gain_ok      = device.get_gain(direction, channel, gain_dB);
+  const bool gain_mode_ok = device.get_gain_mode(direction, channel, gain_mode_auto);
+  const bool bandwidth_ok = device.get_bandwidth(direction, channel, bandwidth_Hz);
+
+  logger.info("Soapy {} ch{} readback: sample_rate_Hz={} frequency_Hz={} gain_dB={:.2f} gain_mode_ok={} "
+              "gain_mode_auto={} bandwidth_Hz={}",
+              direction == SOAPY_SDR_TX ? "TX" : "RX",
+              channel,
+              rate_ok ? rate_Hz : -1.0,
+              freq_ok ? freq_Hz : -1.0,
+              gain_ok ? gain_dB : -1.0,
+              gain_mode_ok ? 1U : 0U,
+              (gain_mode_ok && gain_mode_auto) ? 1U : 0U,
+              bandwidth_ok ? bandwidth_Hz : -1.0);
+
+  if (direct_proof) {
+    fmt::print("PAVONIS_SOAPY_PHYSICAL_CHANNEL_OFFSET direct Soapy {} ch{} readback: "
+               "sample_rate_Hz={} frequency_Hz={} gain_dB={:.2f} gain_mode_ok={} "
+               "gain_mode_auto={} bandwidth_Hz={}\n",
+               direction == SOAPY_SDR_TX ? "TX" : "RX",
+               channel,
+               rate_ok ? rate_Hz : -1.0,
+               freq_ok ? freq_Hz : -1.0,
+               gain_ok ? gain_dB : -1.0,
+               gain_mode_ok ? 1U : 0U,
+               (gain_mode_ok && gain_mode_auto) ? 1U : 0U,
+               bandwidth_ok ? bandwidth_Hz : -1.0);
+  }
+}
