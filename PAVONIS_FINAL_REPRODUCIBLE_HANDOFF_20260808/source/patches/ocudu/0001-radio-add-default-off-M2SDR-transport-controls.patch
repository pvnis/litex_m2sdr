+{
+  if (const char* env = std::getenv("OCUDU_SOAPY_RX_FORMAT")) {
+    const std::string_view value(env);
+    if (value == "cf32" || value == "CF32" || value == "fc32" || value == "FC32" ||
+        value == SOAPY_SDR_CF32 || value == "SOAPY_SDR_CF32") {
