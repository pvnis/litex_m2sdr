+  FILE* out = std::fopen(path, "ab");
+  if (out == nullptr) {
+    return;
+  }
+  for (unsigned i = 0; i != count; ++i) {
+    const float iq[2] = {src[i].real(), src[i].imag()};
+    std::fwrite(iq, sizeof(float), 2, out);
+  }
+  std::fclose(out);
