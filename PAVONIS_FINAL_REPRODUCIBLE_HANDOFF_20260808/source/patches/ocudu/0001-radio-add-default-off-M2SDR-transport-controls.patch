+static uint64_t parse_u64_env(const char* name, uint64_t fallback = 0)
+{
+  const char* value = std::getenv(name);
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return fallback;
+  }
+
+  char*          end = nullptr;
+  const uint64_t parsed = std::strtoull(value, &end, 10);
+  if (end == value) {
+    return fallback;
+  }
+  return parsed;
+}
+
+static unsigned parse_unsigned_env(const char* name, unsigned fallback = 0)
+{
+  return static_cast<unsigned>(parse_u64_env(name, fallback));
