+  FILE*       file = nullptr;
+  unsigned    rows = 0;
+};
+
+static pavonis_si_trace_state& pavonis_si_trace()
+{
+  static pavonis_si_trace_state state = []() {
+    pavonis_si_trace_state init{};
+    init.enabled = pavonis_env_enabled(std::getenv(pavonis_si_trace_enable_env));
+    init.path    = std::getenv(pavonis_si_trace_path_env);
+    if (init.path == nullptr || init.path[0] == '\0') {
+      init.path = pavonis_si_trace_default_path;
+    }
+    init.limit                  = pavonis_read_uint_env(pavonis_si_trace_limit_env, pavonis_si_trace_default_limit, pavonis_si_trace_max_limit);
+    init.power_sign_compat      = pavonis_env_enabled(std::getenv("PAVONIS_GNB_SI_PDSCH_POWER_SIGN_COMPAT"));
+    init.power_offset_ss_env_db = pavonis_read_power_offset_ss_env_db();
+    if (init.enabled) {
+      std::fprintf(stderr,
+                   "%s active path=%s limit=%u power_sign_compat=%u power_offset_ss_env_db=%d\n",
+                   pavonis_si_trace_enable_env,
+                   init.path,
+                   init.limit,
+                   init.power_sign_compat ? 1U : 0U,
+                   init.power_offset_ss_env_db);
+    }
+    return init;
+  }();
+  return state;
+}
