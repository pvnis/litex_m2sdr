+
+  bool expected = false;
+  if (ul_symbol_msg3_target_armed_state().compare_exchange_strong(
+          expected, true, std::memory_order_release, std::memory_order_relaxed)) {
+    std::fprintf(stderr, "PAVONIS_UL_SYMBOL_MSG3_TARGET event=target_armed trigger=%s\n", event);
+  }
+}
+
+inline void ul_symbol_msg3_target_note_ul_information_transfer()
+{
+  if (!ul_symbol_msg3_target_capture_enabled() || !ul_symbol_msg3_target_late_arm_enabled()) {
+    return;
+  }
+
+  if (!ul_symbol_msg3_target_arm_on_dl_after_ul_enabled()) {
+    ul_symbol_msg3_target_arm("ul_information_transfer");
+    return;
+  }
+
+  bool expected = false;
+  if (ul_symbol_msg3_target_ul_primed_state().compare_exchange_strong(
+          expected, true, std::memory_order_release, std::memory_order_relaxed)) {
+    std::fprintf(stderr, "PAVONIS_UL_SYMBOL_MSG3_TARGET event=target_primed trigger=ul_information_transfer\n");
+  }
+}
+
+inline void ul_symbol_msg3_target_note_dl_nas_transport()
+{
+  if (!ul_symbol_msg3_target_capture_enabled() || !ul_symbol_msg3_target_late_arm_enabled() ||
+      !ul_symbol_msg3_target_arm_on_dl_after_ul_enabled() ||
+      !ul_symbol_msg3_target_ul_primed_state().load(std::memory_order_acquire)) {
+    return;
+  }
+
+  ul_symbol_msg3_target_arm("dl_nas_transport_after_ul_information_transfer");
+}
+
+inline unsigned ul_symbol_msg3_target_capture_max_targets()
+{
+  static const unsigned limit = []() {
+    const char* value = std::getenv("PAVONIS_UL_SYMBOL_MSG3_TARGET_MAX");
+    if ((value == nullptr) || (value[0] == '\0')) {
+      return 8U;
+    }
+
+    char* end = nullptr;
+    errno     = 0;
+    unsigned long parsed = std::strtoul(value, &end, 10);
+    if ((errno != 0) || (end == value) || ((end != nullptr) && (*end != '\0')) || (parsed == 0)) {
+      std::fprintf(stderr, "PAVONIS_UL_SYMBOL_MSG3_TARGET_MAX invalid value=%s; using 8\n", value);
+      return 8U;
+    }
+    return static_cast<unsigned>(parsed > 8U ? 8U : parsed);
+  }();
+  return limit;
+}
+
+struct ul_symbol_msg3_target_entry {
+  std::atomic<unsigned> system_slot_plus_one{0};
+  std::atomic<unsigned> symbol_start{0};
+  std::atomic<unsigned> symbol_stop{0};
+  std::atomic<unsigned> temp_crnti{0};
+  std::atomic<unsigned> remaining_slots{0};
+};
+
+struct ul_symbol_msg3_target_state {
+  std::array<ul_symbol_msg3_target_entry, 8> entries{};
+  std::atomic<unsigned>                      published{0};
+};
+
+inline ul_symbol_msg3_target_state& ul_symbol_msg3_targets()
+{
+  static ul_symbol_msg3_target_state state{};
+  return state;
+}
+
+inline void ul_symbol_msg3_target_publish(unsigned system_slot,
+                                          unsigned sfn,
+                                          unsigned slot,
+                                          unsigned symbol_start,
+                                          unsigned symbol_stop,
+                                          unsigned temp_crnti)
+{
+  if (!ul_symbol_msg3_target_capture_enabled()) {
+    return;
+  }
+
+  if (ul_symbol_msg3_target_late_arm_enabled() &&
+      !ul_symbol_msg3_target_armed_state().load(std::memory_order_acquire)) {
+    return;
+  }
+
+  ul_symbol_msg3_target_state& state = ul_symbol_msg3_targets();
+  const unsigned index = state.published.fetch_add(1, std::memory_order_relaxed);
+  if (index >= ul_symbol_msg3_target_capture_max_targets()) {
+    if (index == ul_symbol_msg3_target_capture_max_targets()) {
+      std::fprintf(stderr,
+                   "PAVONIS_UL_SYMBOL_MSG3_TARGET event=target_limit_reached limit=%u\n",
+                   ul_symbol_msg3_target_capture_max_targets());
+    }
+    return;
+  }
+
+  ul_symbol_msg3_target_entry& entry = state.entries[index];
+  entry.symbol_start.store(symbol_start, std::memory_order_relaxed);
+  entry.symbol_stop.store(symbol_stop, std::memory_order_relaxed);
+  entry.temp_crnti.store(temp_crnti, std::memory_order_relaxed);
+  entry.remaining_slots.store(256U, std::memory_order_relaxed);
+  entry.system_slot_plus_one.store(system_slot + 1U, std::memory_order_release);
+  std::fprintf(stderr,
+               "PAVONIS_UL_SYMBOL_MSG3_TARGET event=target_publish idx=%u system_slot=%u sfn=%u slot=%u "
+               "symbol_start=%u symbol_stop=%u temp_crnti=0x%x\n",
+               index,
+               system_slot,
+               sfn,
+               slot,
+               symbol_start,
+               symbol_stop,
+               temp_crnti);
+}
+
+inline int ul_symbol_msg3_target_match(unsigned system_slot, unsigned symbol)
+{
+  if (!ul_symbol_msg3_target_capture_enabled()) {
+    return -1;
+  }
+
+  ul_symbol_msg3_target_state& state = ul_symbol_msg3_targets();
+  const unsigned count = std::min(state.published.load(std::memory_order_acquire),
+                                  ul_symbol_msg3_target_capture_max_targets());
+  for (unsigned index = 0; index != count; ++index) {
+    ul_symbol_msg3_target_entry& entry = state.entries[index];
+    const unsigned encoded_system_slot = entry.system_slot_plus_one.load(std::memory_order_acquire);
+    if (encoded_system_slot != (system_slot + 1U)) {
+      if ((encoded_system_slot != 0) && (symbol == 0)) {
+        unsigned remaining = entry.remaining_slots.load(std::memory_order_relaxed);
+        bool     decremented = false;
+        while (remaining != 0) {
+          if (entry.remaining_slots.compare_exchange_weak(
+                  remaining, remaining - 1U, std::memory_order_relaxed, std::memory_order_relaxed)) {
+            decremented = true;
+            break;
+          }
+        }
+        if (decremented && (remaining == 1U)) {
+          unsigned expected = encoded_system_slot;
+          if (entry.system_slot_plus_one.compare_exchange_strong(
+                  expected, 0U, std::memory_order_release, std::memory_order_relaxed)) {
+            std::fprintf(stderr,
+                         "PAVONIS_UL_SYMBOL_MSG3_TARGET event=target_expired idx=%u target_system_slot=%u "
+                         "current_system_slot=%u\n",
+                         index,
+                         encoded_system_slot - 1U,
+                         system_slot);
+          }
+        }
+      }
+      continue;
+    }
+    if ((symbol >= entry.symbol_start.load(std::memory_order_relaxed)) &&
+        (symbol < entry.symbol_stop.load(std::memory_order_relaxed))) {
+      return static_cast<int>(index);
+    }
+  }
+  return -1;
+}
+
+inline bool ul_symbol_msg3_target_complete_if_last(int      target_index,
+                                                    unsigned system_slot,
+                                                    unsigned symbol,
+                                                    bool     last_channel)
+{
+  if ((target_index < 0) || !last_channel) {
+    return false;
+  }
+
+  ul_symbol_msg3_target_entry& entry = ul_symbol_msg3_targets().entries[static_cast<unsigned>(target_index)];
+  if ((symbol + 1U) < entry.symbol_stop.load(std::memory_order_relaxed)) {
+    return false;
+  }
+
+  unsigned expected = system_slot + 1U;
+  if (entry.system_slot_plus_one.compare_exchange_strong(
+          expected, 0U, std::memory_order_release, std::memory_order_relaxed)) {
+    std::fprintf(stderr,
+                 "PAVONIS_UL_SYMBOL_MSG3_TARGET event=target_complete idx=%d system_slot=%u "
+                 "symbol=%u temp_crnti=0x%x\n",
+                 target_index,
+                 system_slot,
+                 symbol,
+                 entry.temp_crnti.load(std::memory_order_relaxed));
+    return true;
+  }
+  return false;
+}
