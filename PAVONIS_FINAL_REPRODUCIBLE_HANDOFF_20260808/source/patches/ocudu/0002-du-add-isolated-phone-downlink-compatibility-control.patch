+    init.path    = std::getenv(pavonis_rar_fapi_trace_path_env);
+    if (init.path == nullptr || init.path[0] == '\0') {
+      init.path = pavonis_rar_fapi_trace_default_path;
+    }
+    init.limit                  = pavonis_read_uint_env(pavonis_rar_fapi_trace_limit_env,
+                                      pavonis_rar_fapi_trace_default_limit,
+                                      pavonis_rar_fapi_trace_max_limit);
+    init.power_sign_compat      = pavonis_env_enabled(std::getenv("PAVONIS_GNB_SI_PDSCH_POWER_SIGN_COMPAT"));
+    init.power_offset_ss_env_db = pavonis_read_power_offset_ss_env_db();
+    if (init.enabled) {
+      std::fprintf(stderr,
+                   "%s active path=%s limit=%u power_sign_compat=%u power_offset_ss_env_db=%d\n",
+                   pavonis_rar_fapi_trace_enable_env,
+                   init.path,
+                   init.limit,
+                   init.power_sign_compat ? 1U : 0U,
+                   init.power_offset_ss_env_db);
+    }
+    return init;
+  }();
+  return state;
+}
