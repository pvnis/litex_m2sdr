+static bool pavonis_open_si_trace_if_needed(pavonis_si_trace_state& state)
+{
+  if (!state.enabled || state.rows >= state.limit) {
+    return false;
+  }
+  if (state.file != nullptr) {
+    return true;
+  }
+
+  state.file = std::fopen(state.path, "w");
+  if (state.file == nullptr) {
+    std::fprintf(stderr, "%s failed to open path=%s\n", pavonis_si_trace_enable_env, state.path);
+    state.enabled = false;
+    return false;
+  }
+
+  std::fprintf(state.file,
+               "wall_ns\trow\tevent\tsector_id\tslot_abs\tsfn\tslot_index\tslot_mod160\tis_si_lattice\t"
+               "delta_si_slots\ttotal_pdus\tsi_pdcch_count\tsi_pdsch_count\tpdu_index\trnti\tpdcch_context\t"
+               "pdcch_bwp_start\tpdcch_bwp_len\tpdcch_sym_start\tpdcch_sym_len\tpdcch_cce\tpdcch_al\t"
+               "pdcch_al_cces\tpdcch_payload_bits\tpdcch_payload_hex\tpdcch_power_profile\t"
+               "pdcch_power_offset_ss_db\tpdcch_dmrs_power_db\tpdcch_data_power_db\tpdsch_bwp_start\t"
+               "pdsch_bwp_len\tpdsch_vrb_start\tpdsch_vrb_len\tpdsch_sym_start\tpdsch_sym_len\tpdsch_mcs\t"
+               "pdsch_rv\tpdsch_tbs_bytes\tpdsch_mapping\tpdsch_power_profile\tpdsch_power_offset_db\t"
+               "pdsch_power_offset_ss_db\tpower_sign_compat\tpower_offset_ss_env_db\n");
+  std::fflush(state.file);
+  return true;
+}
