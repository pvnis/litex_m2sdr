+static pdsch_processor::pdu_t convert_profile_nr_pdsch_for_rnti(rnti_t rnti)
+{
+  auto                               pm_tools = generate_precoding_matrix_tables(1, 0);
+  const precoding_matrix_repository& pm_repo  = *std::get<std::unique_ptr<precoding_matrix_repository>>(pm_tools);
+
+  fapi::dl_pdsch_pdu         fapi_pdu;
+  fapi::dl_pdsch_pdu_builder builder(fapi_pdu);
+
+  dmrs_symbol_mask dl_dmrs_symbol(14);
+  dl_dmrs_symbol.from_uint64(1U << 2U);
+  fapi::dmrs_ports_mask dmrs_ports(11);
+  dmrs_ports.from_uint64(0);
+
+  builder.set_ue_specific_parameters(rnti)
+      .set_bwp_parameters(crb_interval::start_and_len(0, 52), subcarrier_spacing::kHz15, cyclic_prefix::NORMAL)
+      .set_codeword_generation_parameters(1, 1, fapi::pdsch_ref_point_type::point_a)
+      .set_dmrs_parameters(dl_dmrs_symbol, dmrs_config_type::type1, 1, 0, 2, dmrs_ports)
+      .set_codeword_parameters(units::bytes{50})
+      .set_number_of_csi_puds(0);
+
+  builder.add_codeword().set_codeword_parameters(
+      modulation_scheme::QPSK, sch_mcs_index(5), pdsch_mcs_table::qam64, 0, units::bytes{80});
+  builder.set_frequency_allocation_type_1(vrb_interval::start_and_len(0, 8),
+                                          vrb_to_prb::mapping_type::non_interleaved);
+  builder.set_time_allocation_parameters(ofdm_symbol_range::start_and_len(2, 12));
+  builder.set_profile_nr_tx_power_info_parameters(0, fapi::power_control_offset_ss::dB6);
+  builder.set_ldpc_base_graph(ldpc_base_graph_type::BG1);
+  builder.get_tx_precoding_and_beamforming_pdu_builder().set_pmi(0).set_prg_parameters(51);
+  builder.set_vrb_to_prb_non_interleaved_common_ss_parameters();
+
+  pdsch_processor::pdu_t proc_pdu;
+  convert_pdsch_fapi_to_phy(proc_pdu, fapi_pdu, slot_point(subcarrier_spacing::kHz15, 0, 1), {}, pm_repo);
+  return proc_pdu;
+}
+
+TEST(fapi_to_phy_pdsch_conversion_test, pavonis_si_rnti_power_sign_compatibility)
+{
+  const bool compat_enabled = is_pavonis_si_pdsch_power_sign_compat_env_enabled();
+
+  const pdsch_processor::pdu_t si_pdu     = convert_profile_nr_pdsch_for_rnti(rnti_t::SI_RNTI);
+  const pdsch_processor::pdu_t non_si_pdu = convert_profile_nr_pdsch_for_rnti(to_rnti(0x4601));
+
+  if (compat_enabled) {
+    ASSERT_FLOAT_EQ(-6.0F, si_pdu.ratio_pdsch_data_to_sss_dB);
+    ASSERT_FLOAT_EQ(-6.0F, si_pdu.ratio_pdsch_dmrs_to_sss_dB);
+  } else {
+    ASSERT_FLOAT_EQ(6.0F, si_pdu.ratio_pdsch_data_to_sss_dB);
+    ASSERT_FLOAT_EQ(3.0F, si_pdu.ratio_pdsch_dmrs_to_sss_dB);
+  }
+
+  ASSERT_FLOAT_EQ(6.0F, non_si_pdu.ratio_pdsch_data_to_sss_dB);
+  ASSERT_FLOAT_EQ(3.0F, non_si_pdu.ratio_pdsch_dmrs_to_sss_dB);
+}
