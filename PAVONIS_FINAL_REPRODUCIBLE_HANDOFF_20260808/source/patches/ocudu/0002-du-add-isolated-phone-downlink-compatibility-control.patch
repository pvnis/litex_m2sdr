+}
+
+static const char* pavonis_pdsch_mapping_name(const fapi::dl_pdsch_pdu& pdu)
+{
+  if (std::holds_alternative<fapi::dl_pdsch_pdu::non_interleaved_common_ss>(pdu.mapping)) {
+    return "non_interleaved_common_ss";
+  }
+  if (std::holds_alternative<fapi::dl_pdsch_pdu::non_interleaved_other>(pdu.mapping)) {
+    return "non_interleaved_other";
+  }
+  if (std::holds_alternative<fapi::dl_pdsch_pdu::interleaved_common_type0_coreset0>(pdu.mapping)) {
+    return "interleaved_common_type0_coreset0";
+  }
+  if (std::holds_alternative<fapi::dl_pdsch_pdu::interleaved_common_any_coreset0_present>(pdu.mapping)) {
+    return "interleaved_common_any_coreset0_present";
+  }
+  if (std::holds_alternative<fapi::dl_pdsch_pdu::interleaved_other>(pdu.mapping)) {
+    return "interleaved_other";
+  }
+  return "unknown";
+}
+
+static std::string pavonis_transport_block_hex_prefix(const shared_transport_block& pdu, size_t max_bytes)
+{
+  static constexpr char hex[] = "0123456789abcdef";
+  const span<const uint8_t> buffer = pdu.get_buffer();
+  const size_t              len    = std::min(buffer.size(), max_bytes);
+  std::string               out;
+  out.reserve(len * 2 + (buffer.size() > len ? 3 : 0));
+  for (size_t i = 0; i != len; ++i) {
+    out.push_back(hex[(buffer[i] >> 4U) & 0x0fU]);
+    out.push_back(hex[buffer[i] & 0x0fU]);
+  }
+  if (buffer.size() > len) {
+    out.append("...");
+  }
+  return out;
+}
