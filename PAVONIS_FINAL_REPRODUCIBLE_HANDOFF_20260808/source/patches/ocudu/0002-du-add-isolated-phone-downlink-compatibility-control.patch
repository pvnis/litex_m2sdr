+static bool pavonis_env_enabled(const char* value)
+{
+  if (value == nullptr || value[0] == '\0' || std::strcmp(value, "0") == 0 || std::strcmp(value, "false") == 0 ||
+      std::strcmp(value, "off") == 0) {
+    return false;
+  }
+  return true;
+}
+
+static unsigned pavonis_read_uint_env(const char* name, unsigned default_value, unsigned max_value)
+{
+  const char* value = std::getenv(name);
+  if (value == nullptr || value[0] == '\0') {
+    return default_value;
+  }
+
+  char* end = nullptr;
+  errno     = 0;
+  unsigned long parsed = std::strtoul(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0') {
+    std::fprintf(stderr, "%s invalid value=%s; using %u\n", name, value, default_value);
+    return default_value;
+  }
+
+  return static_cast<unsigned>(std::min<unsigned long>(parsed, max_value));
+}
+
+static int pavonis_read_power_offset_ss_env_db()
+{
+  const char* value = std::getenv("PAVONIS_GNB_POWER_CONTROL_OFFSET_SS_DB");
+  if (value == nullptr || value[0] == '\0') {
+    return -999;
+  }
+
+  char* end = nullptr;
+  errno     = 0;
+  long parsed = std::strtol(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0') {
+    return -998;
+  }
+  return static_cast<int>(parsed);
+}
