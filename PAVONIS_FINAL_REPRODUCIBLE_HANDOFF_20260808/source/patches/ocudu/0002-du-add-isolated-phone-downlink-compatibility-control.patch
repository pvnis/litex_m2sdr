+  char*               end    = nullptr;
+  const unsigned long parsed = std::strtoul(value, &end, 10);
+  if (end == value || end == nullptr || end[0] != '\0' || parsed > 9) {
+    report_error("Invalid PAVONIS_GNB_MAX_MSG4_MCS value={}. Expected an integer from 0 through 9.\n", value);
