new file mode 100644
index 0000000000..05d7b3777b
--- /dev/null
+++ b/include/ocudu/support/pavonis_msg3_path_trace.h
@@ -0,0 +1,138 @@
+// SPDX-FileCopyrightText: Copyright (C) 2026
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#pragma once
+
+#include "ocudu/ran/slot_point.h"
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <climits>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ocudu {
+namespace pavonis {
+
+inline bool msg3_path_trace_enabled()
+{
+  static const bool enabled = []() {
+    const char* value = std::getenv("PAVONIS_MSG3_PATH_TRACE");
+    return value != nullptr && value[0] != '\0' && std::strcmp(value, "0") != 0 &&
+           std::strcmp(value, "false") != 0 && std::strcmp(value, "off") != 0;
+  }();
+  return enabled;
+}
+
+inline unsigned msg3_path_trace_limit()
+{
+  static const unsigned limit = []() {
+    const char* value = std::getenv("PAVONIS_MSG3_PATH_TRACE_LIMIT");
+    if (value == nullptr || value[0] == '\0') {
+      return 1024U;
+    }
+
+    char* end = nullptr;
+    errno     = 0;
+    unsigned long parsed = std::strtoul(value, &end, 10);
+    if (errno != 0 || end == value || *end != '\0') {
+      std::fprintf(stderr, "PAVONIS_MSG3_PATH_TRACE_LIMIT invalid value=%s; using 1024\n", value);
+      return 1024U;
+    }
+    return static_cast<unsigned>(std::min<unsigned long>(parsed, UINT_MAX));
+  }();
+  return limit;
+}
+
+inline unsigned long long msg3_path_trace_steady_ns()
+{
+  return static_cast<unsigned long long>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+inline bool msg3_path_trace_take()
+{
+  if (!msg3_path_trace_enabled()) {
+    return false;
+  }
+
+  const unsigned limit = msg3_path_trace_limit();
+  if (limit == 0) {
+    return false;
+  }
+
+  static std::atomic<unsigned> count{0};
+  const unsigned              row = count.fetch_add(1, std::memory_order_relaxed);
+  if (row < limit) {
+    return true;
+  }
+  if (row == limit) {
+    std::fprintf(stderr,
+                 "PAVONIS_MSG3_PATH_TRACE event=trace_limit_reached steady_ns=%llu limit=%u\n",
+                 msg3_path_trace_steady_ns(),
+                 limit);
+  }
+  return false;
+}
+
+inline void msg3_path_trace_write(const char* event,
+                                  slot_point  slot,
+                                  size_t      payload_len,
+                                  uint64_t    payload_hash,
+                                  int         lcid,
+                                  int         harq_id,
+                                  const char* outcome)
+{
+  const bool valid = slot.valid();
+  std::fprintf(stderr,
+               "PAVONIS_MSG3_PATH_TRACE event=%s steady_ns=%llu slot_valid=%u slot_abs=%u sfn=%u slot=%u "
+               "payload_len=%zu payload_fnv64=%016llx lcid=%d harq_id=%d outcome=%s\n",
+               event,
+               msg3_path_trace_steady_ns(),
+               valid ? 1U : 0U,
+               valid ? slot.to_uint() : 0U,
+               valid ? slot.sfn() : 0U,
+               valid ? slot.slot_index() : 0U,
+               payload_len,
+               static_cast<unsigned long long>(payload_hash),
+               lcid,
+               harq_id,
+               outcome);
+}
+
+inline void
+msg3_path_trace_event(const char* event, slot_point slot, int lcid, int harq_id, const char* outcome)
+{
+  if (!msg3_path_trace_take()) {
+    return;
+  }
+  msg3_path_trace_write(event, slot, 0, 0, lcid, harq_id, outcome);
+}
+
+template <typename Range>
+inline void msg3_path_trace_payload_event(const char*  event,
+                                          slot_point   slot,
+                                          const Range& payload,
+                                          int          lcid,
+                                          int          harq_id,
+                                          const char*  outcome)
+{
+  if (!msg3_path_trace_take()) {
+    return;
+  }
+
+  uint64_t hash = 1469598103934665603ULL;
+  size_t   len  = 0;
+  for (auto byte : payload) {
+    hash ^= static_cast<uint8_t>(byte);
+    hash *= 1099511628211ULL;
+    ++len;
+  }
+  msg3_path_trace_write(event, slot, len, hash, lcid, harq_id, outcome);
+}
+
+} // namespace pavonis
+} // namespace ocudu
diff --git a/include/ocudu/support/pavonis_puxch_order_trace.h b/include/ocudu/support/pavonis_puxch_order_trace.h
new file mode 100644
index 0000000000..2813ef5c6a
--- /dev/null
+++ b/include/ocudu/support/pavonis_puxch_order_trace.h
@@ -0,0 +1,379 @@
+// SPDX-FileCopyrightText: Copyright (C) 2026
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <climits>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ocudu {
+namespace pavonis {
+
+inline bool puxch_order_trace_enabled()
+{
+  static const bool enabled = []() {
+    const char* value = std::getenv("PAVONIS_PUXCH_ORDER_TRACE");
+    return (value != nullptr) && (value[0] != '\0') && (std::strcmp(value, "0") != 0);
+  }();
+  return enabled;
+}
+
+inline unsigned puxch_order_trace_limit()
+{
+  static const unsigned limit = []() {
+    const char* value = std::getenv("PAVONIS_PUXCH_ORDER_TRACE_LIMIT");
+    if ((value == nullptr) || (value[0] == '\0')) {
+      return 500U;
+    }
+
+    char* end = nullptr;
+    errno     = 0;
+    unsigned long parsed = std::strtoul(value, &end, 10);
+    if ((errno != 0) || (end == value) || ((end != nullptr) && (*end != '\0'))) {
+      std::fprintf(stderr, "PAVONIS_PUXCH_ORDER_TRACE_LIMIT invalid value=%s; using 500\n", value);
+      return 500U;
+    }
+
+    return (parsed > UINT_MAX) ? UINT_MAX : static_cast<unsigned>(parsed);
+  }();
+  return limit;
+}
+
+inline bool puxch_order_trace_late_arm_enabled()
+{
+  static const bool enabled = []() {
+    const char* value = std::getenv("PAVONIS_PUXCH_ORDER_TRACE_LATE_ARM");
+    return (value != nullptr) && (value[0] != '\0') && (std::strcmp(value, "0") != 0);
+  }();
+  return enabled;
+}
+
+inline std::atomic<bool>& puxch_order_trace_armed_state()
+{
+  static std::atomic<bool> armed{false};
+  return armed;
+}
+
+inline unsigned long long puxch_order_trace_steady_ns()
+{
+  return static_cast<unsigned long long>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+inline bool puxch_order_trace_take()
+{
+  if (!puxch_order_trace_enabled()) {
+    return false;
+  }
+
+  if (puxch_order_trace_late_arm_enabled() &&
+      !puxch_order_trace_armed_state().load(std::memory_order_acquire)) {
+    return false;
+  }
+
+  const unsigned limit = puxch_order_trace_limit();
+  if (limit == 0) {
+    return false;
+  }
+
+  static std::atomic<unsigned> count{0};
+  unsigned                    index = count.fetch_add(1, std::memory_order_relaxed);
+  if (index < limit) {
+    return true;
+  }
+
+  if (index == limit) {
+    std::fprintf(stderr,
+                 "PAVONIS_PUXCH_ORDER_TRACE event=trace_limit_reached steady_ns=%llu limit=%u\n",
+                 puxch_order_trace_steady_ns(),
+                 limit);
+  }
+  return false;
+}
+
+inline void puxch_order_trace_arm(const char* event)
+{
+  if (!puxch_order_trace_enabled() || !puxch_order_trace_late_arm_enabled()) {
+    return;
+  }
+
+  bool expected = false;
+  if (puxch_order_trace_armed_state().compare_exchange_strong(
+          expected, true, std::memory_order_release, std::memory_order_relaxed)) {
+    std::fprintf(stderr,
+                 "PAVONIS_PUXCH_ORDER_TRACE event=trace_armed steady_ns=%llu trigger=%s\n",
+                 puxch_order_trace_steady_ns(),
+                 event);
+  }
+}
+
+inline void puxch_order_trace_event(const char* event, const char* format, ...)
+{
+  if (!puxch_order_trace_take()) {
+    return;
+  }
+
+  char    details[512];
+  va_list args;
+  va_start(args, format);
+  std::vsnprintf(details, sizeof(details), format, args);
+  va_end(args);
+
+  std::fprintf(stderr,
+               "PAVONIS_PUXCH_ORDER_TRACE event=%s steady_ns=%llu %s\n",
+               event,
+               puxch_order_trace_steady_ns(),
+               details);
+}
+
