+    ocuduvec::convert(channel_buffer, view, scaling_factor_cf_to_ci16);
+  }
+
+  if (ocudu::pavonis::ul_symbol_msg3_target_complete_if_last(
+          pavonis_msg3_target_index,
+          non_prach_shift_current_slot.system_slot(),
+          non_prach_shift_current_symbol_index,
+          true)) {
+    pavonis_get_ul_symbol_manifest_buffer().flush_incremental();
+  }
+
+  non_prach_shift_cfo_processor.advance(non_prach_shift_temp_buffer.get_nof_samples());
+
+  lower_phy_rx_symbol_context puxch_context = {.slot        = non_prach_shift_current_slot,
+                                               .sector      = sector_id,
+                                               .nof_symbols = non_prach_shift_current_symbol_index};
+  bool processed = puxch_proc->get_baseband().process_symbol(non_prach_shift_temp_buffer.get_reader(), puxch_context);
+
+  if (processed) {
