+inline std::atomic<uint64_t>& pavonis_dynamic_non_prach_ul_offset_word()
+{
+  // High 32 bits are a non-zero generation; low 32 bits are a signed sample offset.
+  static std::atomic<uint64_t> word{0};
+  return word;
+}
