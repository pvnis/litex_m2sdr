+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#pragma once
+
+#include "ocudu/ran/phy_time_unit.h"
+#include "ocudu/ran/slot_point.h"
+
+#include <array>
+#include <cstdlib>
+#include <mutex>
+
+namespace ocudu {
+
+inline double pavonis_prach_stage1_raw_samples_to_time_resolution_units(double        raw_samples,
+                                                                        double        sampling_rate_Hz,
+                                                                        phy_time_unit time_resolution)
+{
+  if ((sampling_rate_Hz <= 0.0) || (time_resolution.to_seconds() <= 0.0)) {
+    return raw_samples;
+  }
+  return raw_samples / sampling_rate_Hz / time_resolution.to_seconds();
+}
+
+inline phy_time_unit pavonis_adjust_prach_stage1_time_advance(phy_time_unit time_advance,
+                                                              phy_time_unit time_resolution,
+                                                              double        samples)
+{
+  if (time_resolution.to_seconds() <= 0.0) {
+    return time_advance;
+  }
+
+  const phy_time_unit delta = phy_time_unit::from_seconds(samples * time_resolution.to_seconds());
+  const phy_time_unit adjusted = time_advance + delta;
+  return (adjusted.to_seconds() < 0.0) ? phy_time_unit::from_seconds(0.0) : adjusted;
+}
+
+inline bool pavonis_prach_stage1_ta_compensation_enabled()
+{
+  static const bool enabled = []() {
+    const char* env = std::getenv("PAVONIS_PRACH_STAGE1_TA_COMPENSATE_SELECTED_SHIFT");
+    return (env != nullptr) && (env[0] != '\0') && (env[0] != '0');
+  }();
+  return enabled;
+}
+
+namespace detail {
+
+struct pavonis_prach_stage1_ta_entry {
+  bool     valid   = false;
+  uint32_t key     = 0;
+  double   samples = 0.0;
+};
+
+inline uint32_t pavonis_prach_stage1_ta_key(slot_point slot)
+{
+  return (slot.numerology() << 24U) | slot.to_uint();
+}
+
+inline std::array<pavonis_prach_stage1_ta_entry, 64>& pavonis_prach_stage1_ta_entries()
+{
+  static std::array<pavonis_prach_stage1_ta_entry, 64> entries;
+  return entries;
+}
+
+inline std::mutex& pavonis_prach_stage1_ta_mutex()
+{
+  static std::mutex mutex;
+  return mutex;
+}
+
+} // namespace detail
+
+inline void pavonis_record_prach_stage1_ta_compensation(slot_point slot, double samples)
+{
+  if (!pavonis_prach_stage1_ta_compensation_enabled() || !slot.valid() || (samples == 0.0)) {
+    return;
+  }
+
+  std::lock_guard<std::mutex> lock(detail::pavonis_prach_stage1_ta_mutex());
+  auto&                       entries = detail::pavonis_prach_stage1_ta_entries();
+  const uint32_t              key     = detail::pavonis_prach_stage1_ta_key(slot);
+
+  for (auto& entry : entries) {
+    if (!entry.valid || (entry.key == key)) {
+      entry.valid   = true;
+      entry.key     = key;
+      entry.samples = samples;
+      return;
+    }
+  }
+
+  auto& entry   = entries[key % entries.size()];
+  entry.valid   = true;
+  entry.key     = key;
+  entry.samples = samples;
+}
+
+inline bool pavonis_take_prach_stage1_ta_compensation(slot_point slot, double& samples)
+{
+  if (!pavonis_prach_stage1_ta_compensation_enabled() || !slot.valid()) {
+    return false;
+  }
+
+  std::lock_guard<std::mutex> lock(detail::pavonis_prach_stage1_ta_mutex());
+  auto&                       entries = detail::pavonis_prach_stage1_ta_entries();
+  const uint32_t              key     = detail::pavonis_prach_stage1_ta_key(slot);
+
+  for (auto& entry : entries) {
+    if (entry.valid && (entry.key == key)) {
+      samples     = entry.samples;
+      entry.valid = false;
+      return true;
+    }
+  }
+
+  return false;
+}
+
+} // namespace ocudu
