+static const pavonis_prach_stage1_policy_config& pavonis_get_prach_stage1_policy_config()
+{
+  static const pavonis_prach_stage1_policy_config config = []() {
+    pavonis_prach_stage1_policy_config cfg = {};
+    cfg.enabled                           = pavonis_env_enabled("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_POLICY");
+    cfg.trace_enabled                     = pavonis_env_enabled("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_TRACE");
+    cfg.stop_on_accept                    = pavonis_env_enabled("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_STOP_ON_ACCEPT");
+    cfg.trace_max                         = pavonis_read_env_unsigned("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_TRACE_MAX", 128);
+    cfg.rms_floor_dB                      = pavonis_read_env_double("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_RMS_DB_FLOOR", -70.0);
+    cfg.peak_floor_dB                     = pavonis_read_env_double("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_PEAK_DB_FLOOR", -55.0);
+
+    const int default_shift_min = -std::abs(static_cast<int>(
+        pavonis_read_env_unsigned("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_SHIFT_MIN_ABS", 448)));
+    const int default_shift_max = -std::abs(static_cast<int>(
+        pavonis_read_env_unsigned("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_SHIFT_MAX_ABS", 96)));
+    cfg.shift_min = pavonis_read_env_int("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_SHIFT_MIN", default_shift_min);
+    cfg.shift_max = pavonis_read_env_int("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_SHIFT_MAX", default_shift_max);
+    if (cfg.shift_min > cfg.shift_max) {
+      std::swap(cfg.shift_min, cfg.shift_max);
+    }
+    cfg.shift_step = pavonis_read_env_unsigned("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_SHIFT_STEP", 32);
+    if (cfg.shift_step == 0) {
+      cfg.shift_step = 32;
+    }
+
+    cfg.cfo_min_hz  = pavonis_read_env_double("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_CFO_MIN_HZ", 20000.0);
+    cfg.cfo_max_hz  = pavonis_read_env_double("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_CFO_MAX_HZ", 50000.0);
+    cfg.cfo_step_hz = std::fabs(pavonis_read_env_double("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_CFO_STEP_HZ", 1000.0));
+    if (cfg.cfo_step_hz <= 0.0) {
+      cfg.cfo_step_hz = 1000.0;
+    }
+    if (cfg.cfo_min_hz > cfg.cfo_max_hz) {
+      std::swap(cfg.cfo_min_hz, cfg.cfo_max_hz);
+    }
+
+    cfg.max_candidates = pavonis_read_env_unsigned("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_MAX_CANDIDATES", 1024);
+    cfg.compensate_selected_shift_ta =
+        pavonis_env_enabled("PAVONIS_PRACH_STAGE1_TA_COMPENSATE_SELECTED_SHIFT");
+    cfg.candidate_list =
+        pavonis_parse_stage1_candidate_list(std::getenv("PAVONIS_PRACH_DEMOD_INPUT_STAGE1_CANDIDATE_LIST"));
+    return cfg;
+  }();
+
+  return config;
+}
