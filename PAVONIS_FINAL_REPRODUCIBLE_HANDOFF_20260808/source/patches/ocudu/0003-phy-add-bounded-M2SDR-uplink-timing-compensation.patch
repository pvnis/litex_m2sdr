+inline pavonis_prach_energy_edge_measurement
+pavonis_measure_prach_energy_edge(span<const cf_t> samples, unsigned block_size, int32_t host_active_stop_samples)
+{
+  if ((block_size == 0) || (samples.size() < block_size) || (host_active_stop_samples <= 0)) {
+    return pavonis_prach_energy_edge_measurement{false, 0, 0, 0, 0.0, 0.0, 0.0};
+  }
+
+  const unsigned nof_blocks = static_cast<unsigned>(samples.size() / block_size);
+  std::vector<double> block_rms(nof_blocks, 0.0);
+  for (unsigned block = 0; block != nof_blocks; ++block) {
+    double sum_power = 0.0;
+    for (unsigned index = 0; index != block_size; ++index) {
+      sum_power += std::norm(samples[block * block_size + index]);
+    }
+    block_rms[block] = std::sqrt(sum_power / static_cast<double>(block_size));
+  }
+
+  std::vector<double> sorted_rms = block_rms;
+  std::sort(sorted_rms.begin(), sorted_rms.end());
+  auto percentile = [&sorted_rms](double fraction) {
+    const double position = fraction * static_cast<double>(sorted_rms.size() - 1U);
+    const size_t lower    = static_cast<size_t>(std::floor(position));
+    const size_t upper    = static_cast<size_t>(std::ceil(position));
+    const double weight   = position - static_cast<double>(lower);
+    return sorted_rms[lower] * (1.0 - weight) + sorted_rms[upper] * weight;
+  };
+
+  const double low_rms       = percentile(0.20);
+  // A partially captured PRACH can occupy less than 20% of the widened window.
+  const double high_rms      = percentile(0.90);
+  const double threshold_rms = std::sqrt(low_rms * high_rms);
+  unsigned     best_start    = 0;
+  unsigned     best_stop     = 0;
+  unsigned     run_start     = 0;
+  bool         in_run        = false;
+  for (unsigned block = 0; block != nof_blocks; ++block) {
+    if (block_rms[block] > threshold_rms) {
+      if (!in_run) {
+        run_start = block;
+        in_run    = true;
+      }
+      if ((block + 1U - run_start) > (best_stop - best_start)) {
+        best_start = run_start;
+        best_stop  = block + 1U;
+      }
+    } else {
+      in_run = false;
+    }
+  }
+  if (best_stop == best_start) {
+    return pavonis_prach_energy_edge_measurement{false, 0, 0, 0, low_rms, high_rms, threshold_rms};
+  }
+
+  const int64_t active_start = static_cast<int64_t>(best_start) * block_size;
+  const int64_t active_stop  = static_cast<int64_t>(best_stop) * block_size;
+  const int64_t from_end     = active_stop - host_active_stop_samples;
+  const int64_t edge = (active_start == 0) ? from_end : std::llround((active_start + from_end) / 2.0);
+  if ((edge < INT32_MIN) || (edge > INT32_MAX)) {
+    return pavonis_prach_energy_edge_measurement{false,
+                                                  0,
+                                                  static_cast<unsigned>(active_start),
+                                                  static_cast<unsigned>(active_stop),
+                                                  low_rms,
+                                                  high_rms,
+                                                  threshold_rms};
+  }
+  return pavonis_prach_energy_edge_measurement{true,
+                                                static_cast<int32_t>(edge),
+                                                static_cast<unsigned>(active_start),
+                                                static_cast<unsigned>(active_stop),
+                                                low_rms,
+                                                high_rms,
+                                                threshold_rms};
+}
+
+inline pavonis_dynamic_non_prach_ul_offset_snapshot pavonis_get_dynamic_non_prach_ul_offset()
+{
+  const uint64_t word = detail::pavonis_dynamic_non_prach_ul_offset_word().load(std::memory_order_acquire);
+  const uint32_t generation = static_cast<uint32_t>(word >> 32U);
+  const uint32_t raw_offset = static_cast<uint32_t>(word & UINT32_MAX);
+  const int64_t  offset     = ((raw_offset & (1U << 31U)) != 0)
+                                  ? static_cast<int64_t>(raw_offset) - (static_cast<int64_t>(1) << 32U)
+                                  : static_cast<int64_t>(raw_offset);
+  return pavonis_dynamic_non_prach_ul_offset_snapshot{generation != 0, offset, generation};
+}
+
+inline bool pavonis_publish_dynamic_non_prach_ul_offset(slot_point slot,
+                                                        int        selected_shift,
+                                                        double     selected_frac,
+                                                        double     selected_cfo_hz,
+                                                        float      selected_metric)
+{
+  const detail::pavonis_dynamic_non_prach_ul_offset_config& config =
+      detail::pavonis_dynamic_non_prach_ul_offset_get_config();
+  if (!config.sign_enabled || config.edge_enabled || !slot.valid() || (selected_shift == 0)) {
+    return false;
+  }
+
+  const int32_t offset = (selected_shift < 0) ? config.negative_shift_offset_samples :
+                                                config.positive_shift_offset_samples;
+  std::atomic<uint64_t>& word = detail::pavonis_dynamic_non_prach_ul_offset_word();
+  uint64_t old_word = word.load(std::memory_order_relaxed);
+  uint64_t new_word = 0;
+  uint32_t generation = 0;
+  do {
+    generation = static_cast<uint32_t>(old_word >> 32U) + 1U;
+    if (generation == 0) {
+      generation = 1;
+    }
+    new_word = (static_cast<uint64_t>(generation) << 32U) | static_cast<uint32_t>(offset);
+  } while (!word.compare_exchange_weak(old_word, new_word, std::memory_order_release, std::memory_order_relaxed));
+
+  const unsigned trace_index =
+      detail::pavonis_dynamic_non_prach_ul_offset_trace_count().fetch_add(1, std::memory_order_relaxed);
+  if (trace_index < config.trace_limit) {
+    std::fprintf(stderr,
+                 "PAVONIS_DYNAMIC_NON_PRACH_UL_OFFSET event=publish generation=%u sfn=%u slot=%u "
+                 "system_slot=%u selected_shift=%d selected_frac=%.3f selected_cfo_hz=%.3f "
+                 "selected_metric=%.6f offset_samples=%d\n",
+                 generation,
+                 slot.sfn(),
+                 slot.slot_index(),
+                 slot.system_slot(),
+                 selected_shift,
+                 selected_frac,
+                 selected_cfo_hz,
+                 selected_metric,
+                 offset);
+  }
+  return true;
+}
+
+inline int64_t pavonis_compute_dynamic_non_prach_ul_offset_from_edge(int32_t edge_calibration_samples,
+                                                                     int32_t edge_samples,
+                                                                     int32_t scheduler_error_samples,
+                                                                     int64_t rar_ta_samples)
+{
+  return static_cast<int64_t>(edge_calibration_samples) - edge_samples - scheduler_error_samples + rar_ta_samples;
+}
+
+inline int32_t pavonis_snap_prach_edge_to_lattice(int32_t edge_samples,
+                                                  int32_t anchor_samples,
+                                                  unsigned period_samples)
+{
+  if (period_samples == 0) {
+    return edge_samples;
+  }
+
+  const int64_t delta = static_cast<int64_t>(edge_samples) - anchor_samples;
+  const int64_t half  = period_samples / 2U;
+  const int64_t index = (delta >= 0) ? ((delta + half) / period_samples) :
+                                       -(((-delta) + half) / period_samples);
+  const int64_t snapped = static_cast<int64_t>(anchor_samples) + index * period_samples;
+  if ((snapped < INT32_MIN) || (snapped > INT32_MAX)) {
+    return edge_samples;
+  }
+  return static_cast<int32_t>(snapped);
+}
+
+inline int32_t pavonis_select_prach_edge_lattice_branch(int32_t snapped_edge_samples,
+                                                        bool    canonical_enabled,
+                                                        int32_t canonical_edge_samples)
+{
+  return canonical_enabled ? canonical_edge_samples : snapped_edge_samples;
+}
+
+inline bool pavonis_publish_dynamic_non_prach_ul_offset_from_edge(
+    slot_point                                      slot,
+    const pavonis_prach_energy_edge_measurement&    edge,
+    int                                             selected_shift,
+    double                                          selected_frac,
+    double                                          selected_cfo_hz,
+    float                                           selected_metric,
+    long long                                       measurement_time_us,
+    unsigned                                        rar_ta_command,
+    int64_t                                         rar_ta_samples,
+    const char*                                     source = "prach_edge")
+{
+  const detail::pavonis_dynamic_non_prach_ul_offset_config& config =
+      detail::pavonis_dynamic_non_prach_ul_offset_get_config();
+  if (!config.edge_enabled || !slot.valid() || !edge.valid) {
+    return false;
+  }
+
+  const int64_t applied_rar_ta_samples = config.edge_include_rar_ta ? rar_ta_samples : 0;
+  const unsigned applied_rar_ta_command = config.edge_include_rar_ta ? rar_ta_command : 0;
+  const int32_t snapped_edge_samples =
+      pavonis_snap_prach_edge_to_lattice(
+          edge.edge_samples, config.edge_lattice_anchor_samples, config.edge_lattice_period_samples);
+  const int32_t applied_edge_samples = pavonis_select_prach_edge_lattice_branch(
+      snapped_edge_samples, config.edge_lattice_canonical_enabled, config.edge_lattice_canonical_samples);
+  const int64_t offset64 = pavonis_compute_dynamic_non_prach_ul_offset_from_edge(
+      config.edge_calibration_samples,
+      applied_edge_samples,
+      config.edge_scheduler_interval_error_samples,
+      applied_rar_ta_samples);
+  if ((offset64 < INT32_MIN) || (offset64 > INT32_MAX)) {
+    return false;
+  }
+  const int32_t offset = static_cast<int32_t>(offset64);
+
+  std::atomic<uint64_t>& word = detail::pavonis_dynamic_non_prach_ul_offset_word();
+  uint64_t old_word = word.load(std::memory_order_relaxed);
+  uint64_t new_word = 0;
+  uint32_t generation = 0;
+  do {
+    generation = static_cast<uint32_t>(old_word >> 32U) + 1U;
+    if (generation == 0) {
+      generation = 1;
+    }
+    new_word = (static_cast<uint64_t>(generation) << 32U) | static_cast<uint32_t>(offset);
+  } while (!word.compare_exchange_weak(old_word, new_word, std::memory_order_release, std::memory_order_relaxed));
+
+  const unsigned trace_index =
+      detail::pavonis_dynamic_non_prach_ul_offset_trace_count().fetch_add(1, std::memory_order_relaxed);
+  if (trace_index < config.trace_limit) {
+    const double low_dB = (edge.low_rms > 0.0) ? 20.0 * std::log10(edge.low_rms) : -300.0;
+    const double high_dB = (edge.high_rms > 0.0) ? 20.0 * std::log10(edge.high_rms) : -300.0;
+    const double threshold_dB =
+        (edge.threshold_rms > 0.0) ? 20.0 * std::log10(edge.threshold_rms) : -300.0;
+    std::fprintf(stderr,
+                 "PAVONIS_DYNAMIC_NON_PRACH_UL_OFFSET event=publish source=%s generation=%u "
+                 "sfn=%u slot=%u system_slot=%u selected_shift=%d selected_frac=%.3f "
+                 "selected_cfo_hz=%.3f selected_metric=%.6f edge_samples=%d edge_samples_snapped=%d "
+                 "edge_samples_applied=%d "
+                 "active_start=%u active_stop=%u "
+                 "low_rms_db=%.6f high_rms_db=%.6f threshold_db=%.6f measurement_time_us=%lld "
+                 "scheduler_error=%d rar_ta_command=%u rar_ta_samples=%lld offset_samples=%d\n",
+                 source,
+                 generation,
+                 slot.sfn(),
+                 slot.slot_index(),
+                 slot.system_slot(),
+                 selected_shift,
+                 selected_frac,
+                 selected_cfo_hz,
+                 selected_metric,
+                 edge.edge_samples,
+                 snapped_edge_samples,
+                 applied_edge_samples,
+                 edge.active_start_samples,
+                 edge.active_stop_samples,
+                 low_dB,
+                 high_dB,
+                 threshold_dB,
+                 measurement_time_us,
+                 config.edge_scheduler_interval_error_samples,
+                 applied_rar_ta_command,
+                 static_cast<long long>(applied_rar_ta_samples),
+                 offset);
+  }
+  return true;
+}
+
+} // namespace ocudu
