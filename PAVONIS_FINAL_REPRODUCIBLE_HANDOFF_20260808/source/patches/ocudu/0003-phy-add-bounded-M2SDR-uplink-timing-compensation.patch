+int64_t pavonis_read_env_i64(const char* primary_name, const char* fallback_name = nullptr)
+{
+  const char* name  = primary_name;
+  const char* value = std::getenv(primary_name);
+
+  if (((value == nullptr) || (value[0] == '\0')) && (fallback_name != nullptr)) {
+    const char* fallback_value = std::getenv(fallback_name);
+    if ((fallback_value != nullptr) && (fallback_value[0] != '\0')) {
+      name  = fallback_name;
+      value = fallback_value;
+    }
+  }
+
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return 0;
+  }
+
+  char* end = nullptr;
+  errno     = 0;
+  long long parsed = std::strtoll(value, &end, 10);
+  if ((errno != 0) || (end == value) || ((end != nullptr) && (*end != '\0'))) {
+    std::fprintf(stderr, "%s invalid value=%s; using 0\n", name, value);
+    return 0;
+  }
+
+  if (parsed != 0) {
+    std::fprintf(stderr, "%s active value=%lld\n", name, parsed);
+    if (name == fallback_name) {
+      std::fprintf(stderr,
+                   "%s is a legacy alias; prefer PAVONIS_NON_PRACH_UL_RX_TIMESTAMP_OFFSET_SAMPLES\n",
+                   fallback_name);
+    }
+  }
+
+  return static_cast<int64_t>(parsed);
+}
+
+baseband_gateway_timestamp pavonis_add_signed_timestamp_offset(baseband_gateway_timestamp timestamp, int64_t offset)
+{
+  if (offset >= 0) {
+    return timestamp + static_cast<uint64_t>(offset);
+  }
+
+  const uint64_t magnitude =
+      (offset == LLONG_MIN) ? (static_cast<uint64_t>(LLONG_MAX) + 1U) : static_cast<uint64_t>(-offset);
+  return (timestamp > magnitude) ? (timestamp - magnitude) : 0U;
+}
+
+int64_t pavonis_get_non_prach_ul_rx_timestamp_offset_samples()
+{
+  static const int64_t value = pavonis_read_env_i64("PAVONIS_NON_PRACH_UL_RX_TIMESTAMP_OFFSET_SAMPLES",
+                                                   "PAVONIS_PUXCH_RX_TIMESTAMP_OFFSET_SAMPLES");
+  return value;
+}
+
+std::optional<float> pavonis_get_non_prach_ul_rx_cfo_hz()
+{
+  static const std::optional<float> value = []() -> std::optional<float> {
+    const char* text = std::getenv("PAVONIS_NON_PRACH_UL_RX_CFO_HZ");
+    if ((text == nullptr) || (text[0] == '\0') || (std::strcmp(text, "0") == 0)) {
+      return std::nullopt;
+    }
+
+    char* end = nullptr;
+    errno     = 0;
+    float parsed = std::strtof(text, &end);
+    if ((errno != 0) || (end == text) || ((end != nullptr) && (*end != '\0')) || !std::isfinite(parsed) ||
+        (parsed == 0.0F)) {
+      std::fprintf(stderr, "PAVONIS_NON_PRACH_UL_RX_CFO_HZ invalid value=%s; disabled\n", text);
+      return std::nullopt;
+    }
+    return parsed;
+  }();
+  return value;
+}
