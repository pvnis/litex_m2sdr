+static unsigned pavonis_parse_delay_sequence(const char* env, unsigned (&delays)[pavonis_max_collection_delay_sequence_len])
+{
+  if ((env == nullptr) || (env[0] == '\0')) {
+    return 0;
+  }
+
+  unsigned    count = 0;
+  const char* cursor = env;
+  while ((*cursor != '\0') && (count < pavonis_max_collection_delay_sequence_len)) {
+    while ((*cursor != '\0') && !std::isdigit(static_cast<unsigned char>(*cursor))) {
+      ++cursor;
+    }
+    if (*cursor == '\0') {
+      break;
+    }
+
+    char* end = nullptr;
+    long  parsed = std::strtol(cursor, &end, 10);
+    if (end == cursor) {
+      ++cursor;
+      continue;
+    }
+    if (parsed > 0) {
+      delays[count++] = static_cast<unsigned>(parsed);
+    }
+    cursor = end;
+  }
+
+  return count;
+}
+
+static unsigned pavonis_parse_collection_phase_sequence(
+    const char*                            env,
+    pavonis_collection_phase_entry (&entries)[pavonis_max_collection_delay_sequence_len])
+{
+  if ((env == nullptr) || (env[0] == '\0')) {
+    return 0;
+  }
+
+  unsigned    count  = 0;
+  const char* cursor = env;
+  while ((*cursor != '\0') && (count < pavonis_max_collection_delay_sequence_len)) {
+    while ((*cursor != '\0') && !std::isdigit(static_cast<unsigned char>(*cursor))) {
+      ++cursor;
+    }
+    if (*cursor == '\0') {
+      break;
+    }
+
+    char*         delay_end = nullptr;
+    unsigned long delay     = std::strtoul(cursor, &delay_end, 10);
+    if ((delay_end == cursor) || (*delay_end != ':')) {
+      cursor = (delay_end != cursor) ? delay_end : cursor + 1;
+      continue;
+    }
+
+    char*         report_end = nullptr;
+    unsigned long report     = std::strtoul(delay_end + 1, &report_end, 10);
+    if (report_end == delay_end + 1) {
+      cursor = delay_end + 1;
+      continue;
+    }
+
+    if ((delay <= std::numeric_limits<unsigned>::max()) &&
+        (report <= std::numeric_limits<unsigned>::max())) {
+      entries[count++] = {static_cast<unsigned>(delay), static_cast<unsigned>(report)};
+    }
+    cursor = report_end;
+  }
+
+  return count;
+}
