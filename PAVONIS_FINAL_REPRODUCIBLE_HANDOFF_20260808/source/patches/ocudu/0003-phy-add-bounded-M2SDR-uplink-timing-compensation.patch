+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#pragma once
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+
+namespace ocudu::pavonis {
+
+struct non_prach_ul_pipeline_depth_config {
+  bool     enabled = false;
+  unsigned depth   = 0;
+};
+
+inline const non_prach_ul_pipeline_depth_config& get_non_prach_ul_pipeline_depth_config()
+{
+  static const non_prach_ul_pipeline_depth_config config = []() {
+    const char* value = std::getenv("PAVONIS_NON_PRACH_UL_RX_PIPELINE_DEPTH_SLOTS");
+    if ((value == nullptr) || (value[0] == '\0')) {
+      return non_prach_ul_pipeline_depth_config{};
+    }
+
+    errno                = 0;
+    char*         end    = nullptr;
+    unsigned long parsed = std::strtoul(value, &end, 10);
+    if ((errno != 0) || (end == value) || (end == nullptr) || (*end != '\0') || (parsed < 17) || (parsed > 64)) {
+      std::fprintf(stderr,
+                   "PAVONIS_NON_PRACH_UL_RX_PIPELINE_DEPTH_SLOTS invalid value=%s expected=17..64; disabled\n",
+                   value);
+      return non_prach_ul_pipeline_depth_config{};
+    }
+
+    return non_prach_ul_pipeline_depth_config{true, static_cast<unsigned>(parsed)};
+  }();
+  return config;
+}
+
+} // namespace ocudu::pavonis
