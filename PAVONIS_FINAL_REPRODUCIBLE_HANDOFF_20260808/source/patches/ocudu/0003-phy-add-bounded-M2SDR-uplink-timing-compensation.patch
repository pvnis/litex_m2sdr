+struct pavonis_ul_symbol_manifest_row {
+  unsigned long long symbol_start_ts;
+  unsigned long long symbol_end_ts;
+  long long          wall_ns;
+  double             raw_rms;
+  double             raw_peak;
+  unsigned           idx;
+  unsigned           symbol_size;
+  unsigned           sfn;
+  unsigned           slot;
+  unsigned           symbol;
+  unsigned           sector;
+  unsigned           port;
+  char               raw_path[160];
+};
+
+class pavonis_ul_symbol_manifest_buffer
+{
+public:
+  void append(const pavonis_ul_symbol_manifest_row& row, unsigned reserve_hint, const char* arm_file)
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (flushed) {
+      return;
+    }
+    if (!registered_flush) {
+      std::atexit(pavonis_flush_ul_symbol_manifest);
+      registered_flush = true;
+    }
+    if (!reserved) {
+      rows.reserve(reserve_hint);
+      if (arm_file != nullptr) {
+        std::snprintf(arm_file_path, sizeof(arm_file_path), "%s", arm_file);
+      }
+      reserved = true;
+    }
+    rows.push_back(row);
+  }
+
+  void flush()
+  {
+    flush_impl(true);
+  }
+
+  void flush_incremental()
+  {
+    flush_impl(false);
+  }
+
+private:
+  void flush_impl(bool final)
+  {
+    std::vector<pavonis_ul_symbol_manifest_row> rows_to_write;
+    bool                                        write_header = false;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (flushed) {
+        return;
+      }
+      if (final) {
+        flushed = true;
+      }
+      write_header = !manifest_started;
+      rows_to_write.swap(rows);
+    }
+
+    if (rows_to_write.empty()) {
+      return;
+    }
+
+    std::sort(rows_to_write.begin(),
+              rows_to_write.end(),
+              [](const pavonis_ul_symbol_manifest_row& lhs, const pavonis_ul_symbol_manifest_row& rhs) {
+                return lhs.idx < rhs.idx;
+              });
+
+    FILE* pavonis_manifest =
+        std::fopen("/tmp/pavonis_ul_symbol_manifest.tsv", write_header ? "w" : "a");
+    if (pavonis_manifest == nullptr) {
+      std::fprintf(stderr,
+                   "PAVONIS_UL_SYMBOL_DUMP buffered manifest flush failed path=/tmp/pavonis_ul_symbol_manifest.tsv "
+                   "errno=%d error=%s rows=%zu\n",
+                   errno,
+                   std::strerror(errno),
+                   rows_to_write.size());
+      return;
+    }
+
+    if (write_header) {
+      std::fprintf(pavonis_manifest,
+                   "idx\twall_ns\tsymbol_start_ts\tsymbol_end_ts\tsymbol_size\t"
+                   "sfn\tslot\tsymbol\tsector\tport\traw_rms\traw_peak\tarm_file\traw_path\n");
+    }
+    for (const pavonis_ul_symbol_manifest_row& row : rows_to_write) {
+      std::fprintf(pavonis_manifest,
+                   "%u\t%lld\t%llu\t%llu\t%u\t%u\t%u\t%u\t%u\t%u\t%.9e\t%.9e\t%s\t%s\n",
+                   row.idx,
+                   row.wall_ns,
+                   row.symbol_start_ts,
+                   row.symbol_end_ts,
+                   row.symbol_size,
+                   row.sfn,
+                   row.slot,
+                   row.symbol,
+                   row.sector,
+                   row.port,
+                   row.raw_rms,
+                   row.raw_peak,
+                   arm_file_path,
+                   row.raw_path);
+    }
+    std::fclose(pavonis_manifest);
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      manifest_started = true;
+    }
+    std::fprintf(stderr,
+                 "PAVONIS_UL_SYMBOL_DUMP buffered manifest flushed path=/tmp/pavonis_ul_symbol_manifest.tsv "
+                 "rows=%zu final=%u\n",
+                 rows_to_write.size(),
+                 final ? 1U : 0U);
+  }
+
+  std::mutex                                  mutex;
+  std::vector<pavonis_ul_symbol_manifest_row> rows;
+  char                                        arm_file_path[256] = {};
+  bool                                        registered_flush   = false;
+  bool                                        reserved           = false;
+  bool                                        flushed            = false;
+  bool                                        manifest_started   = false;
+};
+
+pavonis_ul_symbol_manifest_buffer& pavonis_get_ul_symbol_manifest_buffer()
+{
+  static pavonis_ul_symbol_manifest_buffer buffer;
+  return buffer;
+}
+
+void pavonis_flush_ul_symbol_manifest()
+{
+  pavonis_get_ul_symbol_manifest_buffer().flush();
+}
