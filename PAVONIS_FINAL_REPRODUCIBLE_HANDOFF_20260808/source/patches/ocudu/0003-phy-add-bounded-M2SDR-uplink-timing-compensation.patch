+static void pavonis_trace_prach_request_late(const char* branch,
+                                             unsigned    request_sfn,
+                                             unsigned    request_slot,
+                                             unsigned    context_sfn,
+                                             unsigned    context_slot,
+                                             unsigned    context_symbol,
+                                             unsigned long long context_timestamp,
+                                             unsigned    input_samples,
+                                             unsigned    collection_delay_samples,
+                                             bool        target_valid,
+                                             unsigned long long target_timestamp,
+                                             unsigned    timing_compensation_samples)
+{
+  const pavonis_prach_late_context_trace_config& cfg = pavonis_get_prach_late_context_trace_config();
+  if (!cfg.enabled || (cfg.limit == 0)) {
+    return;
+  }
+
+  static std::atomic<unsigned> next_row{0};
+  const unsigned               row = next_row.fetch_add(1, std::memory_order_relaxed);
+  if (row >= cfg.limit) {
+    return;
+  }
+
+  const long long wall_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::system_clock::now().time_since_epoch())
+                                .count();
+  static std::mutex trace_mutex;
+  static bool       initialized = false;
+  std::lock_guard<std::mutex> lock(trace_mutex);
+  FILE* file = std::fopen(cfg.path, initialized ? "a" : "w");
+  if (file == nullptr) {
+    return;
+  }
+  if (!initialized) {
+    std::fprintf(file,
+                 "row\twall_ns\tbranch\trequest_sfn\trequest_slot\tcontext_sfn\tcontext_slot\tcontext_symbol\t"
+                 "context_timestamp\tinput_samples\tcollection_delay_samples\ttarget_valid\ttarget_timestamp\t"
+                 "timing_compensation_samples\n");
+    initialized = true;
+  }
+  std::fprintf(file,
+               "%u\t%lld\t%s\t%u\t%u\t%u\t%u\t%u\t%llu\t%u\t%u\t%u\t%llu\t%u\n",
+               row,
+               wall_ns,
+               branch,
+               request_sfn,
+               request_slot,
+               context_sfn,
+               context_slot,
+               context_symbol,
+               context_timestamp,
+               input_samples,
+               collection_delay_samples,
+               target_valid ? 1U : 0U,
+               target_timestamp,
+               timing_compensation_samples);
+  std::fclose(file);
+}
