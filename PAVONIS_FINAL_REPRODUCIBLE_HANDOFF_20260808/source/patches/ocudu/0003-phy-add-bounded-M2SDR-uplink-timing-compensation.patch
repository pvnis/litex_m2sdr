+static unsigned pavonis_read_env_unsigned(const char* name, unsigned default_value = 0)
+{
+  const char* value = std::getenv(name);
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return default_value;
+  }
+
+  char* end = nullptr;
+  long  parsed = std::strtol(value, &end, 10);
+  if ((end == value) || (parsed < 0)) {
+    return default_value;
+  }
+  return static_cast<unsigned>(parsed);
+}
+
+static int pavonis_read_env_int(const char* name, int default_value = 0)
+{
+  const char* value = std::getenv(name);
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return default_value;
+  }
+
+  char* end = nullptr;
+  long  parsed = std::strtol(value, &end, 10);
+  if (end == value) {
+    return default_value;
+  }
+  return static_cast<int>(parsed);
+}
+
+static double pavonis_read_env_double(const char* name, double default_value = 0.0)
+{
+  const char* value = std::getenv(name);
+  if ((value == nullptr) || (value[0] == '\0')) {
+    return default_value;
+  }
+
+  char*  end    = nullptr;
+  double parsed = std::strtod(value, &end);
+  if (end == value) {
+    return default_value;
+  }
+  return parsed;
+}
+
+static bool pavonis_env_enabled(const char* name)
+{
+  const char* value = std::getenv(name);
+  return (value != nullptr) && (value[0] != '\0') && (std::strcmp(value, "0") != 0);
+}
