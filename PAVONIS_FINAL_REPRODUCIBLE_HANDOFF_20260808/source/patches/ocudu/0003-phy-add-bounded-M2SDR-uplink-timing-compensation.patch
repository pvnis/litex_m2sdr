+      const baseband_gateway_timestamp pavonis_symbol_end_ts =
+          (non_prach_shift_current_symbol_size != 0)
+              ? (non_prach_shift_current_symbol_timestamp + non_prach_shift_current_symbol_size - 1)
+              : non_prach_shift_current_symbol_timestamp;
+      pavonis_ul_symbol_manifest_row pavonis_row = {};
+      pavonis_row.idx = pavonis_idx;
+      pavonis_row.wall_ns = static_cast<long long>(pavonis_wall_ns);
+      pavonis_row.symbol_start_ts =
+          static_cast<unsigned long long>(non_prach_shift_current_symbol_timestamp);
+      pavonis_row.symbol_end_ts = static_cast<unsigned long long>(pavonis_symbol_end_ts);
+      pavonis_row.symbol_size = non_prach_shift_current_symbol_size;
+      pavonis_row.sfn = non_prach_shift_current_slot.sfn();
+      pavonis_row.slot = non_prach_shift_current_slot.slot_index();
+      pavonis_row.symbol = non_prach_shift_current_symbol_index;
+      pavonis_row.sector = sector_id;
+      pavonis_row.port = i_channel;
+      std::snprintf(pavonis_row.raw_path, sizeof(pavonis_row.raw_path), "%s", pavonis_path);
+      pavonis_get_ul_symbol_manifest_buffer().append(pavonis_row, pavonis_shifted_raw_max, "scheduled_msg3_shifted");
