+    const char* dump = std::getenv("PAVONIS_UL_SYMBOL_DUMP");
+    return (dump != nullptr) && ocudu::pavonis::ul_symbol_msg3_target_capture_enabled();
+  }();
+  const int pavonis_msg3_target_index =
+      pavonis_shifted_msg3_target_capture_enabled
+          ? ocudu::pavonis::ul_symbol_msg3_target_match(non_prach_shift_current_slot.system_slot(),
+                                                        non_prach_shift_current_symbol_index)
+          : -1;
+  static const unsigned pavonis_shifted_raw_max = []() {
+    const char* raw_max_env = std::getenv("PAVONIS_UL_SYMBOL_RAW_MAX");
+    int         raw_max_i   = (raw_max_env != nullptr) ? std::atoi(raw_max_env) : 0;
+    return (raw_max_i > 0) ? static_cast<unsigned>(raw_max_i) : 0U;
+  }();
+  static std::atomic<unsigned> pavonis_shifted_target_seen{0};
+  static std::atomic<unsigned> pavonis_shifted_target_raw_seen{0};
+
+  for (unsigned i_channel = 0; i_channel != non_prach_shift_temp_buffer.get_nof_channels(); ++i_channel) {
+    span<ci16_t> channel_buffer = non_prach_shift_temp_buffer.get_writer().get_channel_buffer(i_channel);
+    span<cf_t>   view =
+        non_prach_shift_temp_cf_buffer.get_view({i_channel}).subspan(0, channel_buffer.size());
+    ocuduvec::convert(view, channel_buffer, scaling_factor_ci16_to_cf);
+    non_prach_shift_cfo_processor.process(view);
+
+    avg_power.update(ocuduvec::average_power(view));
+    peak_power.update(ocuduvec::max_abs_element(view).second);
+    nof_clipped_samples += ocuduvec::count_if_part_abs_greater_than(view, 0.95);
+    total_processed_samples += view.size();
+
+    if (pavonis_msg3_target_index >= 0) {
+      const unsigned pavonis_idx = pavonis_shifted_target_seen.fetch_add(1, std::memory_order_relaxed);
+      char           pavonis_path[256] = "";
+      if (pavonis_shifted_raw_max != 0) {
+        const unsigned pavonis_raw_idx =
+            pavonis_shifted_target_raw_seen.fetch_add(1, std::memory_order_relaxed);
+        if (pavonis_raw_idx < pavonis_shifted_raw_max) {
+          std::snprintf(pavonis_path,
+                        sizeof(pavonis_path),
+                        "/tmp/pavonis_puxch_target_%06u_t%02d_s%u_%u_y%u_p%u.cf32",
+                        pavonis_raw_idx,
+                        pavonis_msg3_target_index,
+                        non_prach_shift_current_slot.sfn(),
+                        non_prach_shift_current_slot.slot_index(),
+                        non_prach_shift_current_symbol_index,
+                        i_channel);
+          FILE* pavonis_out = std::fopen(pavonis_path, "wb");
+          if (pavonis_out != nullptr) {
+            for (const cf_t& sample : view) {
+              const float pavonis_iq[2] = {sample.real(), sample.imag()};
+              std::fwrite(pavonis_iq, sizeof(float), 2, pavonis_out);
+            }
+            std::fclose(pavonis_out);
+          }
+        }
+      }
+
+      const auto pavonis_wall_ns =
+          std::chrono::duration_cast<std::chrono::nanoseconds>(
+              std::chrono::system_clock::now().time_since_epoch())
