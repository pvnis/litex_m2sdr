+
+void lower_phy_uplink_processor_impl::process_non_prach_shifted_alignment(
+    const baseband_gateway_buffer_reader& samples,
+    baseband_gateway_timestamp            timestamp)
+{
+  unsigned i_sample_sf = timestamp % nof_samples_per_subframe;
+  unsigned nof_samples = samples.get_nof_samples();
+
+  unsigned nof_samples_next_sf = 0;
+  if (i_sample_sf != 0) {
+    nof_samples_next_sf = nof_samples_per_subframe - i_sample_sf;
+  }
+
+  if (nof_samples_next_sf < nof_samples) {
+    baseband_gateway_buffer_reader_view samples2(samples, nof_samples_next_sf, nof_samples - nof_samples_next_sf);
+    process_non_prach_shifted_symbol_boundary(samples2, timestamp + nof_samples_next_sf);
+    return;
+  }
+
+  non_prach_shift_state = fsm_states::alignment;
+}
+
+void lower_phy_uplink_processor_impl::process_non_prach_shifted_symbol_boundary(
+    const baseband_gateway_buffer_reader& samples,
+    baseband_gateway_timestamp            timestamp)
+{
+  unsigned i_sf = static_cast<uint64_t>((timestamp / nof_samples_per_subframe) %
+                                        (NOF_SFNS * NOF_SUBFRAMES_PER_FRAME));
+
+  unsigned i_sample_sf     = timestamp % nof_samples_per_subframe;
+  unsigned i_sample_symbol = i_sample_sf;
+  unsigned i_symbol_sf     = 0;
+  while (i_sample_symbol >= symbol_sizes[i_symbol_sf]) {
+    i_sample_symbol -= symbol_sizes[i_symbol_sf];
+    ++i_symbol_sf;
+  }
+
+  if (i_sample_symbol != 0) {
+    process_non_prach_shifted_alignment(samples, timestamp);
+    return;
+  }
+
+  unsigned i_slot   = i_sf * nof_slots_per_subframe + i_symbol_sf / nof_symbols_per_slot;
+  unsigned i_symbol = i_symbol_sf % nof_symbols_per_slot;
+
+  slot_point slot(to_numerology_value(scs), i_slot % (NOF_SFNS * NOF_SUBFRAMES_PER_FRAME * nof_slots_per_subframe));
+
+  non_prach_shift_current_slot                = slot;
+  non_prach_shift_current_symbol_index        = i_symbol;
+  non_prach_shift_current_symbol_size         = symbol_sizes[i_symbol_sf];
+  non_prach_shift_temp_buffer_write_index     = 0;
+  non_prach_shift_current_symbol_timestamp    = timestamp;
+  non_prach_shift_temp_buffer.resize(non_prach_shift_current_symbol_size);
+
+  if (i_symbol == 0) {
+    non_prach_shift_cfo_processor.next_cfo_command();
+  }
+
+  process_non_prach_shifted_collecting(samples, timestamp);
+}
+
+void lower_phy_uplink_processor_impl::process_non_prach_shifted_collecting(
+    const baseband_gateway_buffer_reader& samples,
+    baseband_gateway_timestamp            timestamp)
+{
+  ocudu_assert(notifier != nullptr, "Notifier has not been connected.");
+  ocudu_assert(nof_rx_ports == samples.get_nof_channels(), "Invalid number of channels.");
+
+  if ((non_prach_shift_current_symbol_timestamp + non_prach_shift_temp_buffer_write_index) != timestamp) {
+    process_non_prach_shifted_alignment(samples, timestamp);
+    return;
+  }
+
+  unsigned nof_input_samples = samples.get_nof_samples();
+  unsigned nof_samples =
+      std::min(nof_input_samples, non_prach_shift_current_symbol_size - non_prach_shift_temp_buffer_write_index);
+
+  for (unsigned i_port = 0; i_port != nof_rx_ports; ++i_port) {
+    span<ci16_t> temp_buffer_dst =
+        non_prach_shift_temp_buffer[i_port].subspan(non_prach_shift_temp_buffer_write_index, nof_samples);
+    span<const ci16_t> temp_buffer_src = samples.get_channel_buffer(i_port).first(nof_samples);
+    ocuduvec::copy(temp_buffer_dst, temp_buffer_src);
+  }
+
+  non_prach_shift_temp_buffer_write_index += nof_samples;
+
+  if (non_prach_shift_temp_buffer_write_index < non_prach_shift_current_symbol_size) {
+    non_prach_shift_state = fsm_states::collecting;
+    return;
+  }
+
+  sample_statistics<float> avg_power;
+  sample_statistics<float> peak_power;
+  uint64_t                 total_processed_samples = 0;
+  uint64_t                 nof_clipped_samples     = 0;
