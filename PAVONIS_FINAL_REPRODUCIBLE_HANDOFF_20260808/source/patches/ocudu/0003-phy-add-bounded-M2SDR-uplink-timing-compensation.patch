+struct pavonis_prach_stage1_candidate {
+  int    shift;
+  double frac;
+  double cfo_hz;
+};
+
+static std::vector<pavonis_prach_stage1_candidate> pavonis_parse_stage1_candidate_list(const char* env)
+{
+  std::vector<pavonis_prach_stage1_candidate> candidates;
+  if ((env == nullptr) || (*env == '\0')) {
+    return candidates;
+  }
+
+  std::vector<char> buffer(std::strlen(env) + 1U);
+  std::memcpy(buffer.data(), env, buffer.size());
+
+  for (char* token = std::strtok(buffer.data(), ",;"); token != nullptr; token = std::strtok(nullptr, ",;")) {
+    while (std::isspace(static_cast<unsigned char>(*token))) {
+      ++token;
+    }
+    int    shift  = 0;
+    double frac   = 0.0;
+    double cfo_hz = 0.0;
+    if (std::sscanf(token, "%d:%lf:%lf", &shift, &frac, &cfo_hz) == 3) {
+      candidates.push_back({shift, frac, cfo_hz});
+    }
+  }
+
+  return candidates;
+}
