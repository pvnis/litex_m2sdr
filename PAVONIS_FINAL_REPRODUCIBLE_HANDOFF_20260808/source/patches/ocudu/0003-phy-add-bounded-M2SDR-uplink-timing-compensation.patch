+inline const pavonis_dynamic_non_prach_ul_offset_config& pavonis_dynamic_non_prach_ul_offset_get_config()
+{
+  static const pavonis_dynamic_non_prach_ul_offset_config config = []() {
+    const bool sign_enabled =
+        pavonis_dynamic_non_prach_ul_offset_env_enabled("PAVONIS_NON_PRACH_UL_RX_OFFSET_FROM_STAGE1");
+    const bool edge_enabled =
+        pavonis_dynamic_non_prach_ul_offset_env_enabled("PAVONIS_NON_PRACH_UL_RX_OFFSET_FROM_PRACH_EDGE");
+    if (!sign_enabled && !edge_enabled) {
+      return pavonis_dynamic_non_prach_ul_offset_config{
+          false, false, false, false, -241118, -237798, -237332, 0, 8, 10404, 0, -138, false, 0, 0};
+    }
+
+    const bool edge_include_rar_ta = pavonis_dynamic_non_prach_ul_offset_env_enabled(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_INCLUDE_RAR_TA");
+    const bool edge_commit_on_upper_accept = pavonis_dynamic_non_prach_ul_offset_env_enabled(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_COMMIT_ON_UPPER_ACCEPT");
+
+    const int32_t negative = pavonis_dynamic_non_prach_ul_offset_read_i32(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_NEGATIVE_SHIFT_SAMPLES", -241118);
+    const int32_t positive = pavonis_dynamic_non_prach_ul_offset_read_i32(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_POSITIVE_SHIFT_SAMPLES", -237798);
+    const int32_t edge_calibration = pavonis_dynamic_non_prach_ul_offset_read_i32(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_CALIBRATION_SAMPLES", -237332);
+    const int32_t edge_scheduler_error = pavonis_dynamic_non_prach_ul_offset_read_i32(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_SCHEDULER_ERROR_SAMPLES", 0);
+    unsigned edge_block_size =
+        pavonis_dynamic_non_prach_ul_offset_read_unsigned("PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_BLOCK_SIZE", 8);
+    if (edge_block_size == 0) {
+      edge_block_size = 8;
+    }
+    const int32_t edge_host_active_stop = pavonis_dynamic_non_prach_ul_offset_read_i32(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_HOST_ACTIVE_STOP_SAMPLES", 10404);
+    const unsigned edge_lattice_period = pavonis_dynamic_non_prach_ul_offset_read_unsigned(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_LATTICE_PERIOD_SAMPLES", 0);
+    const int32_t edge_lattice_anchor = pavonis_dynamic_non_prach_ul_offset_read_i32(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_LATTICE_ANCHOR_SAMPLES", -138);
+    int32_t edge_lattice_canonical = 0;
+    const bool edge_lattice_canonical_requested = pavonis_dynamic_non_prach_ul_offset_read_optional_i32(
+        "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_LATTICE_CANONICAL_SAMPLES", edge_lattice_canonical);
+    bool edge_lattice_canonical_enabled = false;
+    if (edge_lattice_canonical_requested) {
+      const int64_t canonical_delta = static_cast<int64_t>(edge_lattice_canonical) - edge_lattice_anchor;
+      if (edge_lattice_period == 0) {
+        std::fprintf(stderr,
+                     "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_LATTICE_CANONICAL_SAMPLES ignored because lattice "
+                     "period is zero\n");
+      } else if ((canonical_delta % static_cast<int64_t>(edge_lattice_period)) != 0) {
+        std::fprintf(stderr,
+                     "PAVONIS_NON_PRACH_UL_RX_OFFSET_EDGE_LATTICE_CANONICAL_SAMPLES value=%d is not congruent "
+                     "to anchor=%d period=%u; canonical lattice branch disabled\n",
+                     edge_lattice_canonical,
+                     edge_lattice_anchor,
+                     edge_lattice_period);
+      } else {
+        edge_lattice_canonical_enabled = true;
+      }
+    }
+    const unsigned trace_limit =
+        pavonis_dynamic_non_prach_ul_offset_read_unsigned("PAVONIS_NON_PRACH_UL_RX_OFFSET_TRACE_LIMIT", 64);
+    std::fprintf(stderr,
+                 "PAVONIS_DYNAMIC_NON_PRACH_UL_OFFSET event=config enabled=1 sign_enabled=%u edge_enabled=%u "
+                 "edge_include_rar_ta=%u edge_commit_on_upper_accept=%u negative_shift_offset=%d "
+                 "positive_shift_offset=%d edge_calibration=%d edge_scheduler_error=%d edge_block_size=%u "
+                 "edge_high_percentile=90 edge_host_active_stop=%d edge_lattice_period=%u "
+                 "edge_lattice_anchor=%d edge_lattice_canonical_enabled=%u "
+                 "edge_lattice_canonical=%d trace_limit=%u\n",
+                 sign_enabled ? 1U : 0U,
+                 edge_enabled ? 1U : 0U,
+                 edge_include_rar_ta ? 1U : 0U,
+                 edge_commit_on_upper_accept ? 1U : 0U,
+                 negative,
+                 positive,
+                 edge_calibration,
+                 edge_scheduler_error,
+                 edge_block_size,
+                 edge_host_active_stop,
+                 edge_lattice_period,
+                 edge_lattice_anchor,
+                 edge_lattice_canonical_enabled ? 1U : 0U,
+                 edge_lattice_canonical,
+                 trace_limit);
+    return pavonis_dynamic_non_prach_ul_offset_config{sign_enabled,
+                                                      edge_enabled,
+                                                      edge_include_rar_ta,
+                                                      edge_commit_on_upper_accept,
+                                                      negative,
+                                                      positive,
+                                                      edge_calibration,
+                                                      edge_scheduler_error,
+                                                      edge_block_size,
+                                                      edge_host_active_stop,
+                                                      edge_lattice_period,
+                                                      edge_lattice_anchor,
+                                                      edge_lattice_canonical_enabled,
+                                                      edge_lattice_canonical,
+                                                      trace_limit};
+  }();
+  return config;
+}
