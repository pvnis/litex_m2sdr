-static void pavonis_trace_si_occasion_if_enabled(const fapi::dl_tti_request& msg, unsigned sector_id)
-{
-  pavonis_si_trace_state& state = pavonis_si_trace();
-  if (!state.enabled || state.rows >= state.limit) {
-    return;
-  }
-
-  unsigned si_pdcch_count = 0;
-  unsigned si_pdsch_count = 0;
-  for (const auto& pdu : msg.pdus) {
-    if (const auto* pdcch = std::get_if<fapi::dl_pdcch_pdu>(&pdu.pdu)) {
-      si_pdcch_count += (pdcch->dl_dci.rnti == rnti_t::SI_RNTI) ? 1U : 0U;
-      continue;
-    }
-    if (const auto* pdsch = std::get_if<fapi::dl_pdsch_pdu>(&pdu.pdu)) {
-      si_pdsch_count += (pdsch->rnti == rnti_t::SI_RNTI) ? 1U : 0U;
-      continue;
-    }
-  }
-
-  const bool is_si_lattice = (msg.slot.to_uint() % 160U) == 1U;
-  if (!is_si_lattice && si_pdcch_count == 0 && si_pdsch_count == 0) {
-    return;
-  }
-
-  int delta_si_slots = -1;
-  if (state.last_si_slot_valid) {
-    const uint32_t current_slot = msg.slot.to_uint();
-    const uint32_t hyper_slots  = msg.slot.nof_slots_per_hyper_system_frame();
-    delta_si_slots = static_cast<int>((current_slot + hyper_slots - state.last_si_slot) % hyper_slots);
-  }
-  state.last_si_slot       = msg.slot.to_uint();
-  state.last_si_slot_valid = true;
-
-  pavonis_write_si_trace_summary(state, msg, sector_id, si_pdcch_count, si_pdsch_count, delta_si_slots);
-  if (state.rows >= state.limit) {
-    return;
-  }
-
-  for (unsigned pdu_index = 0, nof_pdus = msg.pdus.size(); pdu_index != nof_pdus; ++pdu_index) {
-    const auto& pdu = msg.pdus[pdu_index];
-    if (const auto* pdcch = std::get_if<fapi::dl_pdcch_pdu>(&pdu.pdu)) {
-      if (pdcch->dl_dci.rnti == rnti_t::SI_RNTI) {
-        pavonis_write_si_trace_pdcch(state, msg, sector_id, pdu_index, *pdcch, si_pdcch_count, si_pdsch_count, delta_si_slots);
-      }
-    } else if (const auto* pdsch = std::get_if<fapi::dl_pdsch_pdu>(&pdu.pdu)) {
-      if (pdsch->rnti == rnti_t::SI_RNTI) {
-        pavonis_write_si_trace_pdsch(state, msg, sector_id, pdu_index, *pdsch, si_pdcch_count, si_pdsch_count, delta_si_slots);
-      }
-    }
-
-    if (state.rows >= state.limit) {
-      return;
-    }
-  }
-}
