+    let (du, _qc, _dn, builder, _logger) = TestFrameworkBuilder::<MockDu>::new()
+        .serving_network(PlmnIdentity([0x09, 0xf1, 0x07]), SERVING_NETWORK_NAME)
+        .build()
+        .await?;
+    let mut ue = builder.f1ap_ue(&du).build().await?;
+    ue.use_serving_network_name(SERVING_NETWORK_NAME);
+
+    ue.perform_rrc_setup().await?;
+    ue.handle_nas_authentication().await?;
+    ue.handle_nas_security_mode().await?;
+    ue.handle_rrc_security_mode().await?;
+    ue.handle_capability_enquiry().await?;
+    ue.handle_nas_registration_accept().await?;
+    ue.handle_nas_configuration_update().await
+}
diff --git a/tests/tests/registration_unknown_update_fallback.rs b/tests/tests/registration_unknown_update_fallback.rs
