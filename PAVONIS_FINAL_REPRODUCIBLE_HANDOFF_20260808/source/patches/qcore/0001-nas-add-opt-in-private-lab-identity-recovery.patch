+use qcore_tests::framework::*;
+
+#[async_std::test]
+async fn registration_unknown_update_uses_identity_fallback() -> anyhow::Result<()> {
+    unsafe {
+        std::env::set_var("PAVONIS_QCORE_ALLOW_UNKNOWN_UPDATE_IDENTITY_FALLBACK", "1");
+    }
+
+    let (gnb, _qc, _dn, builder, _logger) = init_ngap().await?;
+    let mut ue = builder.ngap_ue(&gnb).build().await?;
+
+    ue.use_guti([0, 241, 16, 1, 1, 0, 0, 0, 0, 9]);
+    ue.send_nas_registration_update().await?;
+    ue.data.guti = None;
+
+    ue.handle_identity_procedure().await?;
+    ue.handle_nas_authentication().await?;
+    ue.handle_nas_security_mode().await?;
+    gnb.handle_initial_context_setup(&mut ue).await?;
+    gnb.send_ue_radio_capability_info(&mut ue).await?;
+    ue.handle_nas_registration_accept().await?;
+    ue.handle_nas_configuration_update().await
+}
