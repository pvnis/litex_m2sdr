@@ -0,0 +1,11 @@
+use qcore_tests::framework::*;
+
+#[async_std::test]
+async fn registration_foreign_guti_default_off_is_rejected() -> anyhow::Result<()> {
+    let (du, _qc, _dn, builder, _logger) = init_f1ap().await?;
+    let mut ue = builder.f1ap_ue(&du).build().await?;
+
+    ue.use_guti([9, 241, 7, 5, 5, 5, 0, 0, 0, 0]);
+    ue.perform_rrc_setup().await?;
+    ue.receive_nas_registration_reject().await
+}
diff --git a/tests/tests/registration_foreign_supi_default_off.rs b/tests/tests/registration_foreign_supi_default_off.rs
new file mode 100644
