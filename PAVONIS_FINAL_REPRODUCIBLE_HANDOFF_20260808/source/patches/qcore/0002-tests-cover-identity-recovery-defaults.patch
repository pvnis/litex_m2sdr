--- /dev/null
+++ b/tests/tests/registration_foreign_supi_default_off.rs
@@ -0,0 +1,17 @@
+use qcore_tests::{MockDu, framework::*};
+use xxap::PlmnIdentity;
+
+const SERVING_NETWORK_NAME: &str = "5G:mnc070.mcc901.3gppnetwork.org";
+
+#[async_std::test]
+async fn registration_foreign_supi_default_off_is_rejected() -> anyhow::Result<()> {
+    let (du, _qc, _dn, builder, _logger) = TestFrameworkBuilder::<MockDu>::new()
+        .serving_network(PlmnIdentity([0x09, 0xf1, 0x07]), SERVING_NETWORK_NAME)
+        .build()
+        .await?;
+    let mut ue = builder.f1ap_ue(&du).build().await?;
+    ue.use_serving_network_name(SERVING_NETWORK_NAME);
+
+    ue.perform_rrc_setup().await?;
+    ue.receive_nas_registration_reject().await
+}
