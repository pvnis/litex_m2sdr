diff --git a/qcore/src/userplane/netlink.rs b/qcore/src/userplane/netlink.rs
index f0b7ec0..079a14c 100644
--- a/qcore/src/userplane/netlink.rs
+++ b/qcore/src/userplane/netlink.rs
@@ -53,15 +53,15 @@ impl Netlink {
             .execute();
 
         while let Some(Ok(interface)) = interfaces.next().await {
-            if let Ok(ipv4) = self.first_ipv4_address_of(interface.header.index).await {
-                if ipv4 == *addr {
-                    for attr in interface.attributes {
-                        if let LinkAttribute::IfName(name) = attr {
-                            return Some(name);
-                        }
+            if let Ok(ipv4) = self.first_ipv4_address_of(interface.header.index).await
+                && ipv4 == *addr
+            {
+                for attr in interface.attributes {
+                    if let LinkAttribute::IfName(name) = attr {
+                        return Some(name);
                     }
