+int arm_tx_worker_trace_on_setup_ack()
+{
+  const std::string& path = setup_ack_tx_worker_trace_arm_path();
+  if (path.empty()) {
+    return 0;
+  }
+
+  static std::atomic<bool> attempted{false};
+  bool                     expected = false;
+  if (not attempted.compare_exchange_strong(expected, true, std::memory_order_relaxed)) {
+    return 0;
+  }
+
+  int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+  if (fd >= 0) {
+    close(fd);
+    return 1;
+  }
+  return errno == EEXIST ? 1 : -errno;
+}
