 srsenb/src/stack/upper/gtpu.cc             |  45 ---------
 srsenb/src/stack/upper/pdcp.cc             |  39 --------
 srsgnb/src/stack/mac/mac_nr.cc             | 111 +--------------------
 4 files changed, 1 insertion(+), 228 deletions(-)

