-                     row,
-                     rnti,
-                     lcid,
-                     bytes,
-                     first8,
-                     bearer.is_valid(),
-                     bearer.eps_bearer_id,
-                     static_cast<unsigned>(bearer.rat));
-    }
     if (not bearer.is_valid()) {
       logger.error("Bearer rnti=0x%x, lcid=%d not found", rnti, lcid);
       return;
@@ -93,22 +75,6 @@ public:
   }
 
